msgstr "Allgemein"

msgid "Date Style"
msgstr "Datumsformat"

msgid "Choose between shortened and full date names."
msgstr "Wählen Sie zwischen verkürzten und vollständigen Datumsangaben."

msgid "Short"
msgstr "Kurz"

msgid "Full"
msgstr "Vollständig"

msgid "Cursor Blinking"
msgstr "Blinkender Cursor"

msgid "Enable or disable text cursor blinking in the password field."
msgstr "Aktiviert oder deaktiviert das Blinken des Cursors im Passwortfeld."

msgid "Custom Lockscreen Wallpaper"
msgstr "Eigenes Sperrbildschirm-Hintergrundbild"

msgid "Use a custom image overlay for the lockscreen background."
msgstr "Verwendet ein benutzerdefiniertes Bild als Hintergrund für den Sperrbildschirm."

msgid "Wallpaper Image Path"
msgstr "Pfad zum Hintergrundbild"

msgid "No image selected"
msgstr "Kein Bild ausgewählt"

msgid "Select Image File"
msgstr "Bilddatei auswählen"

msgid "Select Lockscreen Wallpaper"
msgstr "Sperrbildschirm-Hintergrundbild auswählen"

msgid "Select"
msgstr "Auswählen"

msgid "Cancel"
msgstr "Abbrechen"

msgid "Image Files"
msgstr "Bilddateien"

msgid "Lockscreen Mode"
msgstr "Sperrbildschirm-Modus"

msgid "Mode"
msgstr "Modus"

msgid "Legacy"
msgstr "Klassisch"

msgid "Cupertino"
msgstr "Cupertino"

msgid "A complete macOS Sonoma-inspired lockscreen layout (Click user-icon to switch users)."
msgstr "Vollständiges, an macOS Sonoma angelehntes Sperrbildschirm-Layout (auf das Benutzersymbol klicken, um Benutzer zu wechseln)."

msgid "macOS Sonoma-style clock over the classic, GNOME-compliant layout and flow."
msgstr "Uhr im Stil von macOS Sonoma über dem klassischen, GNOME-konformen Layout."

msgid "Always Show User Widget"
msgstr "Benutzer-Widget immer anzeigen"

msgid "Hides notifications by default. Press Shift+N to show notifications."
msgstr "Blendet Benachrichtigungen standardmäßig aus. Umschalt+N drücken, um sie anzuzeigen."

msgid "Prompt Vibrancy"
msgstr "Transparenzeffekt des Passwortfelds"

msgid "Adaptive color and depth enhancements for the password field."
msgstr "Adaptive Farb- und Tiefeneffekte für das Passwortfeld."

msgid "Tonal"
msgstr "Tonal"

msgid "Acrylic"
msgstr "Acryl"

msgid "Lightweight, color-based mode."
msgstr "Ressourcenschonender, farbbasierter Modus."

msgid "Advanced, blur-based mode."
msgstr "Erweiterter, unschärfebasierter Modus."

msgid "Show message when locked"
msgstr "Nachricht bei Sperrung anzeigen"

msgid "Set..."
msgstr "Festlegen…"

msgid "Set a message to appear on the lockscreen"
msgstr "Nachricht für den Sperrbildschirm festlegen"

msgid "OK"
msgstr "OK"

msgid "Unlock Crossfade"
msgstr "Überblenden beim Entsperren"

msgid "Crossfade the lockscreen with desktop when unlocking (automatically disabled in Power Saver mode)."
msgstr "Überblendet den Sperrbildschirm beim Entsperren mit dem Schreibtisch (im Energiesparmodus automatisch deaktiviert)."

msgid "Requires WACK Shell to be installed and enabled."
msgstr "Erfordert, dass WACK Shell installiert und aktiviert ist."

msgid "Requires WACK Shell to be enabled."
msgstr "Erfordert, dass WACK Shell aktiviert ist."

msgid "Crossfade Speed"
msgstr "Überblendgeschwindigkeit"

msgid "Slower"
msgstr "Langsamer"

msgid "Faster"
msgstr "Schneller"

msgid "Clock Animation"
msgstr "Uhrenanimation"

msgid "Applied to the date and time while opening the password prompt"
msgstr "Wird beim Öffnen der Passworteingabe auf Datum und Uhrzeit angewendet"

msgid "Prompt Animation"
msgstr "Authentifizierungsfeld-Animation"

msgid "Applied to the authentication prompt while it appears"
msgstr "Wird beim Einblenden auf das Authentifizierungsfeld angewendet"

msgid "Reset Animations"
msgstr "Animationen zurücksetzen"

msgid "Restore defaults"
msgstr "Standardwerte wiederherstellen"

msgid "Reset animations"
msgstr "Animationen zurücksetzen"

msgid "Scale Down"
msgstr "Verkleinern"

msgid "Zoom Up"
msgstr "Vergrößern"

msgid "Slide Up"
msgstr "Nach oben schieben"

msgid "Fade"
msgstr "Ausblenden"

msgid "GNOME Default"
msgstr "GNOME-Standard"

msgid "Rise"
msgstr "Aufsteigen"

msgid "Zoom"
msgstr "Zoom"

msgid "Screen Timeout"
msgstr "Bildschirm-Ausschaltzeit"

msgid "Display and Power"
msgstr "Bildschirm und Energie"

msgid "Keep Screen On"
msgstr "Bildschirm eingeschaltet lassen"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "Verhindert, dass sich der Bildschirm beim Sperren sofort ausschaltet. Er schaltet sich nach der in den Systemeinstellungen festgelegten Zeit aus."

msgid "Only on AC Power"
msgstr "Nur am Netzstrom"

msgid "Only keep the screen on if the system is plugged in"
msgstr "Den Bildschirm nur eingeschaltet lassen, wenn das Gerät am Stromnetz angeschlossen ist"

msgid "Escape to Sleep / Suspend"
msgstr "Escape für Ruhezustand / Bereitschaft"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "Drücken Sie auf dem Sperrbildschirm Escape, um den Bildschirm auszuschalten (oder in Bereitschaft zu versetzen)"

msgid "Extras"
msgstr "Extras"

msgid "Integrations"
msgstr "Integrationen"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] GDM Expansion"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "Status: Aktiviert. Das angepasste Layout ist auf GDM aktiv."

msgid "Enabled"
msgstr "Aktiviert"

msgid "GDM Expansion - Remove"
msgstr "GDM-Erweiterung - Entfernen"

msgid "Revert GDM login screen layout to GNOME Default. To uninstall, run copied command in a terminal."
msgstr "Setzt das GDM-Anmeldebildschirm-Layout auf den GNOME-Standard zurück. Zum Deinstallieren den kopierten Befehl im Terminal ausführen."

msgid "Copy uninstall command to clipboard"
msgstr "Deinstallationsbefehl in die Zwischenablage kopieren"

msgid "Copied uninstall command to clipboard!"
msgstr "Deinstallationsbefehl in die Zwischenablage kopiert!"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "Die Erweiterung ist nicht systemweit in /usr/share installiert."

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "GDM-Erweiterungsmodule (src/pro) fehlen systemweit."

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "Der GDM-Sitzungsmodus ist in den systemweiten Metadaten nicht aktiviert."

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "Die GDM-dconf-Konfiguration (/etc/dconf/db/gdm.d) fehlt."

msgid "GDM integration is not configured."
msgstr "Die GDM-Integration ist nicht konfiguriert."

msgid "Status: Disabled."
msgstr "Status: Deaktiviert."

msgid "Disabled"
msgstr "Deaktiviert"

msgid "Enable GDM DLC Support"
msgstr "GDM-DLC-Unterstützung aktivieren"

msgid "Click icon to copy installer command, then run it in a terminal."
msgstr "Auf das Symbol klicken, um den Installationsbefehl zu kopieren, und diesen im Terminal ausführen."

msgid "Copy install command to clipboard"
msgstr "Installationsbefehl in die Zwischenablage kopieren"

msgid "Copied install command to clipboard!"
msgstr "Installationsbefehl in die Zwischenablage kopiert!"

msgid "Upgrade to [PRO]"
msgstr "Auf [PRO] upgraden"

msgid "Check PRO features of this extension on this extension's GitHub repo."
msgstr "Entdecken Sie die PRO-Funktionen dieser Erweiterung im GitHub-Repository."

msgid "Visit documentation on GitHub"
msgstr "Dokumentation auf GitHub ansehen"

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] WACK Shell-Integration"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "Installiert. Aktiviert Überblendübergänge und an Cupertino angelehnte Shell-Anpassungen."

msgid "Installed"
msgstr "Installiert"

msgid "WACK Shell - Check for Updates"
msgstr "WACK Shell - Nach Updates suchen"

msgid "Copy check command to verify if a newer version of WACK Shell is available."
msgstr "Den Befehl kopieren, um zu prüfen, ob eine neuere Version von WACK Shell verfügbar ist."

msgid "Copy update-check command to clipboard"
msgstr "Befehl zur Update-Prüfung kopieren"

msgid "Copied WACK Shell update-check command to clipboard!"
msgstr "Befehl zur WACK Shell-Update-Prüfung in die Zwischenablage kopiert!"

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "Nicht installiert. Installieren Sie WACK Shell, um Übergangseffekte freizuschalten."

msgid "Not Installed"
msgstr "Nicht installiert"

msgid "WACK Shell - Install"
msgstr "WACK Shell - Installieren"

msgid "Get advanced desktop crossfade transitions and Cupertino-inspired shell customisations. May contain bugs, report if found."
msgstr "Holen Sie sich erweiterte Überblendübergänge und an Cupertino angelehnte Shell-Anpassungen. Kann Fehler enthalten; bitte melden, falls gefunden."

msgid "Copied WACK Shell install command to clipboard!"
msgstr "WACK Shell-Installationsbefehl in die Zwischenablage kopiert!"

msgid "Open WACK Shell repository"
msgstr "WACK Shell-Repository öffnen"

msgid "Clear Visual Cache"
msgstr "Visuellen Cache leeren"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "Löscht temporäre visuelle Daten für Hintergrundbilder und Transparenzeffekte. Diese werden automatisch neu erstellt."

msgid "Clear"
msgstr "Leeren"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "Leert den visuellen Cache für Hintergrundbilder und Transparenzeffekte"

msgid "Visual cache cleared successfully!"
msgstr "Visueller Cache erfolgreich geleert!"

msgid "Failed to clear cache:"
msgstr "Fehler beim Leeren des Caches:"

