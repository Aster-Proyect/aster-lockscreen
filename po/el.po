msgid "more"
msgstr "περισσότερα"

msgid "Press Shift + N to view notifications"
msgstr "Πατήστε Shift + N για προβολή ειδοποιήσεων"

msgid "Sleep prevented by an active process"
msgstr "Η αναστολή λειτουργίας αποτράπηκε από ενεργή διεργασία"

msgid "Home"
msgstr "Αρχική"

msgid "Resources"
msgstr "Πόροι"

msgid "Extension Repo"
msgstr "Αποθετήριο επέκτασης"

msgid "Open on GitHub"
msgstr "Άνοιγμα στο GitHub"

msgid "Enjoying this extension?"
msgstr "Σας αρέσει αυτή η επέκταση;"

msgid "Consider supporting its development!"
msgstr "Σκεφτείτε να υποστηρίξετε την ανάπτυξή της!"

msgid "Ko-fi"
msgstr "Ko-fi"

msgid "Open Ko-fi"
msgstr "Άνοιγμα Ko-fi"

msgid "Saweria"
msgstr "Saweria"

msgid "Open Saweria"
msgstr "Άνοιγμα Saweria"

msgid "Configuration"
msgstr "Διαμόρφωση"

msgid "General"
msgstr "Γενικά"

msgid "Date Style"
msgstr "Στυλ ημερομηνίας"

msgid "Choose between shortened and full date names."
msgstr "Επιλέξτε μεταξύ συντομευμένων και πλήρων ονομάτων ημερομηνιών."

msgid "Short"
msgstr "Σύντομο"

msgid "Full"
msgstr "Πλήρες"

msgid "Cursor Blinking"
msgstr "Αναβοσβήσιμο δρομέα"

msgid "Enable or disable text cursor blinking in the password field."
msgstr "Ενεργοποίηση ή απενεργοποίηση του αναβοσβήματος του δρομέα στο πεδίο κωδικού πρόσβασης."

msgid "Custom Lockscreen Wallpaper"
msgstr "Προσαρμοσμένη ταπετσαρία οθόνης κλειδώματος"

msgid "Use a custom image overlay for the lockscreen background."
msgstr "Χρησιμοποιήστε μια προσαρμοσμένη εικόνα ως φόντο για την οθόνη κλειδώματος."

msgid "Wallpaper Image Path"
msgstr "Διαδρομή εικόνας ταπετσαρίας"

msgid "No image selected"
msgstr "Δεν έχει επιλεγεί εικόνα"

msgid "Select Image File"
msgstr "Επιλογή αρχείου εικόνας"

msgid "Select Lockscreen Wallpaper"
msgstr "Επιλογή ταπετσαρίας οθόνης κλειδώματος"

msgid "Select"
msgstr "Επιλογή"

msgid "Cancel"
msgstr "Ακύρωση"

msgid "Image Files"
msgstr "Αρχεία εικόνων"

msgid "Lockscreen Mode"
msgstr "Λειτουργία οθόνης κλειδώματος"

msgid "Mode"
msgstr "Λειτουργία"

msgid "Legacy"
msgstr "Κλασικό"

msgid "Cupertino"
msgstr "Cupertino"

msgid "A complete macOS Sonoma-inspired lockscreen layout (Click user-icon to switch users)."
msgstr "Μια πλήρης διάταξη οθόνης κλειδώματος εμπνευσμένη από το macOS Sonoma (κάντε κλικ στο εικονίδιο χρήστη για εναλλαγή χρηστών)."

msgid "macOS Sonoma-style clock over the classic, GNOME-compliant layout and flow."
msgstr "Ρολόι σε στυλ macOS Sonoma πάνω από την κλασική διάταξη του GNOME."

msgid "Always Show User Widget"
msgstr "Πάντα εμφάνιση γραφικού στοιχείου χρήστη"

msgid "Hides notifications by default. Press Shift+N to show notifications."
msgstr "Αποκρύπτει τις ειδοποιήσεις από προεπιλογή. Πατήστε Shift+N για εμφάνιση."

msgid "Prompt Vibrancy"
msgstr "Οπτικό εφέ πεδίου κωδικού πρόσβασης"

msgid "Adaptive color and depth enhancements for the password field."
msgstr "Προσαρμοστικές βελτιώσεις χρώματος και βάθους για το πεδίο κωδικού πρόσβασης."

msgid "Tonal"
msgstr "Τονικό"

msgid "Acrylic"
msgstr "Ακρυλικό"

msgid "Lightweight, color-based mode."
msgstr "Ελαφριά λειτουργία βασισμένη στο χρώμα."

msgid "Advanced, blur-based mode."
msgstr "Προηγμένη λειτουργία βασισμένη στη θόλωση."

msgid "Show message when locked"
msgstr "Εμφάνιση μηνύματος κατά το κλείδωμα"

msgid "Set..."
msgstr "Ορισμός…"

msgid "Set a message to appear on the lockscreen"
msgstr "Ορίστε ένα μήνυμα που θα εμφανίζεται στην οθόνη κλειδώματος"

msgid "OK"
msgstr "OK"

msgid "Unlock Crossfade"
msgstr "Βαθμιαία μετάβαση κατά το ξεκλείδωμα"

msgid "Crossfade the lockscreen with desktop when unlocking (automatically disabled in Power Saver mode)."
msgstr "Βαθμιαία μετάβαση της οθόνης κλειδώματος στην επιφάνεια εργασίας κατά το ξεκλείδωμα (απενεργοποιείται αυτόματα στη λειτουργία εξοικονόμησης ενέργειας)."

msgid "Requires WACK Shell to be installed and enabled."
msgstr "Απαιτείται η εγκατάσταση και ενεργοποίηση του WACK Shell."

msgid "Requires WACK Shell to be enabled."
msgstr "Απαιτείται η ενεργοποίηση του WACK Shell."

msgid "Crossfade Speed"
msgstr "Ταχύτητα βαθμιαίας μετάβασης"

msgid "Slower"
msgstr "Πιο αργά"

msgid "Faster"
msgstr "Πιο γρήγορα"

msgid "Clock Animation"
msgstr "Κίνηση ρολογιού"

msgid "Applied to the date and time while opening the password prompt"
msgstr "Εφαρμόζεται στην ημερομηνία και ώρα κατά το άνοιγμα της γραμμής κωδικού πρόσβασης"

msgid "Prompt Animation"
msgstr "Κίνηση πεδίου ταυτοποίησης"

msgid "Applied to the authentication prompt while it appears"
msgstr "Εφαρμόζεται στο πεδίο ταυτοποίησης κατά την εμφάνισή του"

msgid "Reset Animations"
msgstr "Επαναφορά κινήσεων"

msgid "Restore defaults"
msgstr "Επαναφορά προεπιλογών"

msgid "Reset animations"
msgstr "Επαναφορά κινήσεων"

msgid "Scale Down"
msgstr "Σμίκρυνση"

msgid "Zoom Up"
msgstr "Μεγέθυνση"

msgid "Slide Up"
msgstr "Ολίσθηση προς τα πάνω"

msgid "Fade"
msgstr "Απόσβεση"

msgid "GNOME Default"
msgstr "Προεπιλογή GNOME"

msgid "Rise"
msgstr "Ανύψωση"

msgid "Zoom"
msgstr "Ζουμ"

msgid "Screen Timeout"
msgstr "Χρονικό όριο οθόνης"

msgid "Display and Power"
msgstr "Οθόνη και ενέργεια"

msgid "Keep Screen On"
msgstr "Διατήρηση οθόνης ενεργής"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "Αποτρέπει την άμεση απενεργοποίηση της οθόνης κατά το κλείδωμα. Η οθόνη θα απενεργοποιηθεί μετά το κανονικό χρονικό όριο των ρυθμίσεων συστήματος."

msgid "Only on AC Power"
msgstr "Μόνο σε τροφοδοσία ρεύματος"

msgid "Only keep the screen on if the system is plugged in"
msgstr "Διατήρηση της οθόνης ενεργής μόνο εάν η συσκευή είναι συνδεδεμένη στο ρεύμα"

msgid "Escape to Sleep / Suspend"
msgstr "Escape για απενεργοποίηση οθόνης / αναστολή"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "Πατήστε Escape στην οθόνη κλειδώματος για απενεργοποίηση της οθόνης (ή αναστολή)"

msgid "Extras"
msgstr "Πρόσθετα"

msgid "Integrations"
msgstr "Ενσωματώσεις"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] GDM Expansion"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "Κατάσταση: Ενεργοποιημένο. Η προσαρμοσμένη διάταξη είναι ενεργή στο GDM."

msgid "Enabled"
msgstr "Ενεργοποιημένο"

msgid "GDM Expansion - Remove"
msgstr "Επέκταση GDM - Κατάργηση"

msgid "Revert GDM login screen layout to GNOME Default. To uninstall, run copied command in a terminal."
msgstr "Επαναφορά της οθόνης σύνδεσης GDM στην προεπιλογή του GNOME. Για απεγκατάσταση, εκτελέστε την αντιγραμμένη εντολή σε ένα τερματικό."

msgid "Copy uninstall command to clipboard"
msgstr "Αντιγραφή εντολής απεγκατάστασης στο πρόχειρο"

msgid "Copied uninstall command to clipboard!"
msgstr "Η εντολή απεγκατάστασης αντιγράφηκε στο πρόχειρο!"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "Η επέκταση δεν είναι εγκατεστημένη σε επίπεδο συστήματος στο /usr/share."

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "Τα αρθρώματα επέκτασης GDM (src/pro) λείπουν από το σύστημα."

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "Η λειτουργία συνεδρίας GDM δεν είναι ενεργοποιημένη στα μεταδεδομένα συστήματος."

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "Λείπει η διαμόρφωση παράκαμψης dconf του GDM (/etc/dconf/db/gdm.d)."

msgid "GDM integration is not configured."
msgstr "Η ενσωμάτωση GDM δεν έχει ρυθμιστεί."

msgid "Status: Disabled."
msgstr "Κατάσταση: Απενεργοποιημένο."

msgid "Disabled"
msgstr "Απενεργοποιημένο"

msgid "Enable GDM DLC Support"
msgstr "Ενεργοποίηση υποστήριξης GDM DLC"

msgid "Click icon to copy installer command, then run it in a terminal."
msgstr "Κάντε κλικ στο εικονίδιο για να αντιγράψετε την εντολή εγκατάστασης και, στη συνέχεια, εκτελέστε την σε ένα τερματικό."

msgid "Copy install command to clipboard"
msgstr "Αντιγραφή εντολής εγκατάστασης στο πρόχειρο"

msgid "Copied install command to clipboard!"
msgstr "Η εντολή εγκατάστασης αντιγράφηκε στο πρόχειρο!"

msgid "Upgrade to [PRO]"
msgstr "Αναβάθμιση σε [PRO]"

msgid "Check PRO features of this extension on this extension's GitHub repo."
msgstr "Δείτε τις λειτουργίες PRO αυτής της επέκτασης στο αποθετήριο GitHub της."

msgid "Visit documentation on GitHub"
msgstr "Δείτε την τεκμηρίωση στο GitHub"

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] Ενσωμάτωση WACK Shell"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "Εγκατεστημένο. Ενεργοποιεί μεταβάσεις βαθμιαίας απόσβεσης και προσαρμογές του κελύφους εμπνευσμένες από το Cupertino."

msgid "Installed"
msgstr "Εγκατεστημένο"

msgid "WACK Shell - Check for Updates"
msgstr "WACK Shell - Έλεγχος για ενημερώσεις"

msgid "Copy check command to verify if a newer version of WACK Shell is available."
msgstr "Αντιγράψτε την εντολή για να ελέγξετε εάν είναι διαθέσιμη νεότερη έκδοση του WACK Shell."

msgid "Copy update-check command to clipboard"
msgstr "Αντιγραφή εντολής ελέγχου ενημερώσεων"

msgid "Copied WACK Shell update-check command to clipboard!"
msgstr "Η εντολή ελέγχου ενημερώσεων του WACK Shell αντιγράφηκε στο πρόχειρο!"

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "Δεν είναι εγκατεστημένο. Εγκαταστήστε το WACK Shell για να ξεκλειδώσετε τα εφέ μετάβασης."

msgid "Not Installed"
msgstr "Μη εγκατεστημένο"

msgid "WACK Shell - Install"
msgstr "WACK Shell - Εγκατάσταση"

msgid "Get advanced desktop crossfade transitions and Cupertino-inspired shell customisations. May contain bugs, report if found."
msgstr "Αποκτήστε προηγμένες μεταβάσεις βαθμιαίας απόσβεσης και προσαρμογές του κελύφους εμπνευσμένες από το Cupertino. Ενδέχεται να περιέχει σφάλματα· αναφέρετέ τα εάν βρεθούν."

msgid "Copied WACK Shell install command to clipboard!"
msgstr "Η εντολή εγκατάστασης του WACK Shell αντιγράφηκε στο πρόχειρο!"

msgid "Open WACK Shell repository"
msgstr "Άνοιγμα αποθετηρίου WACK Shell"

msgid "Clear Visual Cache"
msgstr "Εκκαθάριση προσωρινής μνήμης γραφικών"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "Διαγράφει τα προσωρινά οπτικά δεδομένα που χρησιμοποιούνται για ταπετσαρίες και οπτικά εφέ. Θα αναγεννηθούν αυτόματα."

msgid "Clear"
msgstr "Εκκαθάριση"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "Εκκαθαρίζει την προσωρινή μνήμη γραφικών που χρησιμοποιείται για ταπετσαρίες και οπτικά εφέ"

msgid "Visual cache cleared successfully!"
msgstr "Η προσωρινή μνήμη γραφικών εκκαθαρίστηκε επιτυχώς!"

msgid "Failed to clear cache:"
msgstr "Αποτυχία εκκαθάρισης προσωρινής μνήμης:"

