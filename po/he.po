msgid "more"
msgstr "עוד"

msgid "Press Shift + N to view notifications"
msgstr "הקש Shift + N כדי להציג התראות"

msgid "Sleep prevented by an active process"
msgstr "ההשהיה נמנעה על ידי תהליך פעיל"

msgid "Home"
msgstr "בית"

msgid "Resources"
msgstr "משאבים"

msgid "Extension Repo"
msgstr "מאגר ההרחבה"

msgid "Open on GitHub"
msgstr "פתח ב-GitHub"

msgid "Enjoying this extension?"
msgstr "נהנה מהרחבה זו?"

msgid "Consider supporting its development!"
msgstr "שקול לתמוך בפיתוח שלה!"

msgid "Ko-fi"
msgstr "Ko-fi"

msgid "Open Ko-fi"
msgstr "פתח את Ko-fi"

msgid "Saweria"
msgstr "Saweria"

msgid "Open Saweria"
msgstr "פתח את Saweria"

msgid "Configuration"
msgstr "הגדרות"

msgid "General"
msgstr "כללי"

msgid "Date Style"
msgstr "סגנון תאריך"

msgid "Choose between shortened and full date names."
msgstr "בחר בין שמות תאריכים מקוצרים למלאים."

msgid "Short"
msgstr "קצר"

msgid "Full"
msgstr "מלא"

msgid "Cursor Blinking"
msgstr "הבהוב סמן"

msgid "Enable or disable text cursor blinking in the password field."
msgstr "הפעל או השבת הבהוב סמן טקסט בשדה הסיסמה."

msgid "Custom Lockscreen Wallpaper"
msgstr "רקע מותאם אישית למסך הנעילה"

msgid "Use a custom image overlay for the lockscreen background."
msgstr "השתמש בתמונה מותאמת אישית כרקע למסך הנעילה."

msgid "Wallpaper Image Path"
msgstr "נתיב תמונת הרקע"

msgid "No image selected"
msgstr "לא נבחרה תמונה"

msgid "Select Image File"
msgstr "בחר קובץ תמונה"

msgid "Select Lockscreen Wallpaper"
msgstr "בחר רקע למסך הנעילה"

msgid "Select"
msgstr "בחר"

msgid "Cancel"
msgstr "ביטול"

msgid "Image Files"
msgstr "קבצי תמונה"

msgid "Lockscreen Mode"
msgstr "מצב מסך נעילה"

msgid "Mode"
msgstr "מצב"

msgid "Legacy"
msgstr "קלאסי"

msgid "Cupertino"
msgstr "קופרטינו"

msgid "A complete macOS Sonoma-inspired lockscreen layout (Click user-icon to switch users)."
msgstr "פריסת מסך נעילה מלאה בהשראת macOS Sonoma (לחץ על סמל המשתמש כדי להחליף משתמש)."

msgid "macOS Sonoma-style clock over the classic, GNOME-compliant layout and flow."
msgstr "שעון בסגנון macOS Sonoma על גבי הפריסה והזרימה הקלאסית של GNOME."

msgid "Always Show User Widget"
msgstr "הצג תמיד את ווידג'ט המשתמש"

msgid "Hides notifications by default. Press Shift+N to show notifications."
msgstr "הסתרת התראות כברירת מחדל. הקש Shift+N כדי להציג אותן."

msgid "Prompt Vibrancy"
msgstr "מראה חזותי של שדה הסיסמה"

msgid "Adaptive color and depth enhancements for the password field."
msgstr "שיפורי צבע ועומק מותאמים אישית לשדה הסיסמה."

msgid "Tonal"
msgstr "מבוסס גוון"

msgid "Acrylic"
msgstr "אקרילי"

msgid "Lightweight, color-based mode."
msgstr "מצב קל משקל מבוסס צבע."

msgid "Advanced, blur-based mode."
msgstr "מצב מתקדם מבוסס טשטוש."

msgid "Show message when locked"
msgstr "הצג הודעה בעת נעילה"

msgid "Set..."
msgstr "הגדר…"

msgid "Set a message to appear on the lockscreen"
msgstr "הגדר הודעה שתוצג במסך הנעילה"

msgid "OK"
msgstr "אישור"

msgid "Unlock Crossfade"
msgstr "מעבר עמעום בעת פתיחת נעילה"

msgid "Crossfade the lockscreen with desktop when unlocking (automatically disabled in Power Saver mode)."
msgstr "מעבר עמעום הדרגתי בין מסך הנעילה לשולחן העבודה בעת ביטול הנעילה (מושבת אוטומטית במצב חיסכון בחשמל)."

msgid "Requires WACK Shell to be installed and enabled."
msgstr "דורש ש-WACK Shell יהיה מותקן ומופעל."

msgid "Requires WACK Shell to be enabled."
msgstr "דורש ש-WACK Shell יהיה מופעל."

msgid "Crossfade Speed"
msgstr "מהירות עמעום"

msgid "Slower"
msgstr "איטי יותר"

msgid "Faster"
msgstr "מהיר יותר"

msgid "Clock Animation"
msgstr "אנימציית שעון"

msgid "Applied to the date and time while opening the password prompt"
msgstr "מוחל על התאריך והשעה בעת פתיחת שדה הסיסמה"

msgid "Prompt Animation"
msgstr "אנימציית שדה אימות"

msgid "Applied to the authentication prompt while it appears"
msgstr "מוחל על שדה האימות בעת הופעתו"

msgid "Reset Animations"
msgstr "איפוס אנימציות"

msgid "Restore defaults"
msgstr "שחזר ברירות מחדל"

msgid "Reset animations"
msgstr "איפוס אנימציות"

msgid "Scale Down"
msgstr "הקטנה"

msgid "Zoom Up"
msgstr "הגדלה"

msgid "Slide Up"
msgstr "החלקה למעלה"

msgid "Fade"
msgstr "עמעום"

msgid "GNOME Default"
msgstr "ברירת מחדל של GNOME"

msgid "Rise"
msgstr "עלייה"

msgid "Zoom"
msgstr "תקריב"

msgid "Screen Timeout"
msgstr "זמן קצוב למסך"

msgid "Display and Power"
msgstr "מסך וצריכת חשמל"

msgid "Keep Screen On"
msgstr "השאר מסך דולק"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "מונע מכיבוי מיידי של המסך בעת נעילה. המסך עדיין ייכבה לאחר משך הזמן הרגיל שהוגדר בהגדרות המערכת."

msgid "Only on AC Power"
msgstr "רק בחיבור לחשמל"

msgid "Only keep the screen on if the system is plugged in"
msgstr "השאר את המסך דולק רק אם המכשיר מחובר לחשמל"

msgid "Escape to Sleep / Suspend"
msgstr "Escape לכיבוי המסך / השהיה"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "הקש Escape במסך הנעילה כדי לכבות את התצוגה (או לעבור להשהיה)"

msgid "Extras"
msgstr "תוספות"

msgid "Integrations"
msgstr "אינטגרציות"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] GDM Expansion"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "סטטוס: מופעל. הפריסה המותאמת אישית פעילה ב-GDM."

msgid "Enabled"
msgstr "מופעל"

msgid "GDM Expansion - Remove"
msgstr "הרחבת GDM - הסרה"

msgid "Revert GDM login screen layout to GNOME Default. To uninstall, run copied command in a terminal."
msgstr "החזר את פריסת מסך הכניסה של GDM לברירת המחדל של GNOME. כדי להסיר, הפעל את הפקודה המועתקת במסוף."

msgid "Copy uninstall command to clipboard"
msgstr "העתק פקודת הסרה ללוח הגזירים"

msgid "Copied uninstall command to clipboard!"
msgstr "פקודת ההסרה הועתקה ללוח!"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "ההרחבה אינה מותקנת ברמת המערכת ב-/usr/share."

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "מודולי הרחבת GDM (src/pro) חסרים ברמת המערכת."

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "מצב הפעלת GDM אינו מופעל במטא-נתונים של המערכת."

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "תצורת עקיפת dconf של GDM (/etc/dconf/db/gdm.d) חסרה."

msgid "GDM integration is not configured."
msgstr "שילוב GDM אינו מוגדר."

msgid "Status: Disabled."
msgstr "סטטוס: מושבת."

msgid "Disabled"
msgstr "מושבת"

msgid "Enable GDM DLC Support"
msgstr "הפעל תמיכת GDM DLC"

msgid "Click icon to copy installer command, then run it in a terminal."
msgstr "לחץ על הסמל כדי להעתיק את פקודת ההתקנה, ולאחר מכן הפעל אותה במסוף."

msgid "Copy install command to clipboard"
msgstr "העתק פקודת התקנה ללוח הגזירים"

msgid "Copied install command to clipboard!"
msgstr "פקודת ההתקנה הועתקה ללוח!"

msgid "Upgrade to [PRO]"
msgstr "שדרג ל-[PRO]"

msgid "Check PRO features of this extension on this extension's GitHub repo."
msgstr "בדוק את תכונות ה-PRO של הרחבה זו במאגר ה-GitHub שלה."

msgid "Visit documentation on GitHub"
msgstr "בקר בתיעוד ב-GitHub"

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] שילוב WACK Shell"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "מותקן. מאפשר מעברי עמעום והתאמות אישיות למעטפת בהשראת Cupertino."

msgid "Installed"
msgstr "מותקן"

msgid "WACK Shell - Check for Updates"
msgstr "WACK Shell - בדוק אם יש עדכונים"

msgid "Copy check command to verify if a newer version of WACK Shell is available."
msgstr "העתק את הפקודה כדי לבדוק אם קיימת גרסה חדשה יותר של WACK Shell."

msgid "Copy update-check command to clipboard"
msgstr "העתק פקודת בדיקת עדכונים ללוח"

msgid "Copied WACK Shell update-check command to clipboard!"
msgstr "פקודת בדיקת העדכונים של WACK Shell הועתקה ללוח!"

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "לא מותקן. התקן את WACK Shell כדי לבטל את נעילת אפקטי המעבר."

msgid "Not Installed"
msgstr "לא מותקן"

msgid "WACK Shell - Install"
msgstr "WACK Shell - התקנה"

msgid "Get advanced desktop crossfade transitions and Cupertino-inspired shell customisations. May contain bugs, report if found."
msgstr "קבל מעברי עמעום מתקדמים בשולחן העבודה והתאמות אישיות למעטפת בהשראת Cupertino. עשוי להכיל באגים, אנא דווח אם מצאת."

msgid "Copied WACK Shell install command to clipboard!"
msgstr "פקודת ההתקנה של WACK Shell הועתקה ללוח!"

msgid "Open WACK Shell repository"
msgstr "פתח את מאגר WACK Shell"

msgid "Clear Visual Cache"
msgstr "ניקוי מטמון חזותי"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "מוחק נתונים חזותיים זמניים המשמשים לרקעים ואפקטים חזותיים. הם ייווצרו מחדש באופן אוטומטי."

msgid "Clear"
msgstr "נקה"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "מנקה את המטמון החזותי המשמש לרקעים ואפקטים חזותיים"

msgid "Visual cache cleared successfully!"
msgstr "המטמון החזותי נוקה בהצלחה!"

msgid "Failed to clear cache:"
msgstr "ניקוי המטמון נכשל:"

