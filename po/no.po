msgstr "Bildefiler"

msgid "Lockscreen Mode"
msgstr "Låseskjermmodus"

msgid "Mode"
msgstr "Modus"

msgid "Legacy"
msgstr "Klassisk"

msgid "Cupertino"
msgstr "Cupertino"

msgid "A complete macOS Sonoma-inspired lockscreen layout (Click user-icon to switch users)."
msgstr "Et fullstendig macOS Sonoma-inspirert låseskjermoppsett (klikk på brukerikonet for å bytte bruker)."

msgid "macOS Sonoma-style clock over the classic, GNOME-compliant layout and flow."
msgstr "Klokke i macOS Sonoma-stil over det klassiske, GNOME-kompatible oppsettet."

msgid "Always Show User Widget"
msgstr "Vis alltid brukerwidgeten"

msgid "Hides notifications by default. Press Shift+N to show notifications."
msgstr "Skjuler varsler som standard. Trykk Shift+N for å vise dem."

msgid "Prompt Vibrancy"
msgstr "Visuell effekt for passordfeltet"

msgid "Adaptive color and depth enhancements for the password field."
msgstr "Adaptive farge- og dybdeforbedringer for passordfeltet."

msgid "Tonal"
msgstr "Tonal"

msgid "Acrylic"
msgstr "Akryl"

msgid "Lightweight, color-based mode."
msgstr "Lett, fargebasert modus."

msgid "Advanced, blur-based mode."
msgstr "Avansert, uskarphetsbasert modus."

msgid "Show message when locked"
msgstr "Vis melding ved låsing"

msgid "Set..."
msgstr "Angi…"

msgid "Set a message to appear on the lockscreen"
msgstr "Angi en melding som skal vises på låseskjermen"

msgid "OK"
msgstr "OK"

msgid "Unlock Crossfade"
msgstr "Kryssuttoning ved opplåsing"

msgid "Crossfade the lockscreen with desktop when unlocking (automatically disabled in Power Saver mode)."
msgstr "Myk overgang mellom låseskjerm og skrivebord ved opplåsing (deaktiveres automatisk i strømsparingsmodus)."

msgid "Requires WACK Shell to be installed and enabled."
msgstr "Krever at WACK Shell er installert og aktivert."

msgid "Requires WACK Shell to be enabled."
msgstr "Krever at WACK Shell er aktivert."

msgid "Crossfade Speed"
msgstr "Overgangshastighet"

msgid "Slower"
msgstr "Saktere"

msgid "Faster"
msgstr "Raskere"

msgid "Clock Animation"
msgstr "Klokkeanimasjon"

msgid "Applied to the date and time while opening the password prompt"
msgstr "Brukes på dato og klokkeslett når passordfeltet åpnes"

msgid "Prompt Animation"
msgstr "Autentiseringsanimasjon"

msgid "Applied to the authentication prompt while it appears"
msgstr "Brukes på autentiseringsfeltet når det vises"

msgid "Reset Animations"
msgstr "Tilbakestill animasjoner"

msgid "Restore defaults"
msgstr "Gjenopprett standarder"

msgid "Reset animations"
msgstr "Tilbakestill animasjoner"

msgid "Scale Down"
msgstr "Forminsk"

msgid "Zoom Up"
msgstr "Forstørr"

msgid "Slide Up"
msgstr "Gli oppover"

msgid "Fade"
msgstr "Tone"

msgid "GNOME Default"
msgstr "GNOME-standard"

msgid "Rise"
msgstr "Hev"

msgid "Zoom"
msgstr "Zoom"

msgid "Screen Timeout"
msgstr "Skjermtidsavbrudd"

msgid "Display and Power"
msgstr "Skjerm og strøm"

msgid "Keep Screen On"
msgstr "Hold skjermen på"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "Forhindrer at skjermen slås av umiddelbart ved låsing. Skjermen slås av etter den vanlige tidsgrensen angitt i systeminnstillingene."

msgid "Only on AC Power"
msgstr "Kun ved nettstrøm"

msgid "Only keep the screen on if the system is plugged in"
msgstr "Hold bare skjermen på hvis maskinen er koblet til strøm"

msgid "Escape to Sleep / Suspend"
msgstr "Escape for å slå av skjerm / hvilemodus"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "Trykk Escape på låseskjermen for å slå av skjermen (eller gå i hvilemodus)"

msgid "Extras"
msgstr "Ekstra"

msgid "Integrations"
msgstr "Integrasjoner"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] GDM Expansion"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "Status: Aktivert. Egendefinert oppsett er aktivt på GDM."

msgid "Enabled"
msgstr "Aktivert"

msgid "GDM Expansion - Remove"
msgstr "GDM-utvidelse - Fjern"

msgid "Revert GDM login screen layout to GNOME Default. To uninstall, run copied command in a terminal."
msgstr "Tilbakestill innloggingsskjermen i GDM til GNOME-standard. Kjør den kopierte kommandoen i en terminal for å avinstallere."

msgid "Copy uninstall command to clipboard"
msgstr "Kopier avinstalleringskommando til utklippstavlen"

msgid "Copied uninstall command to clipboard!"
msgstr "Avinstalleringskommando kopiert til utklippstavlen!"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "Utvidelsen er ikke installert for hele systemet i /usr/share."

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "GDM-utvidelsesmoduler (src/pro) mangler for hele systemet."

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "GDM-sesjonsmodus er ikke aktivert i metadata for hele systemet."

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "GDM dconf-overstyringskonfigurasjon (/etc/dconf/db/gdm.d) mangler."

msgid "GDM integration is not configured."
msgstr "GDM-integrasjon er ikke konfigurert."

msgid "Status: Disabled."
msgstr "Status: Deaktivert."

msgid "Disabled"
msgstr "Deaktivert"

msgid "Enable GDM DLC Support"
msgstr "Aktiver GDM DLC-støtte"

msgid "Click icon to copy installer command, then run it in a terminal."
msgstr "Klikk på ikonet for å kopiere installasjonskommandoen, og kjør den deretter i en terminal."

msgid "Copy install command to clipboard"
msgstr "Kopier installasjonskommando til utklippstavlen"

msgid "Copied install command to clipboard!"
msgstr "Installasjonskommando kopiert til utklippstavlen!"

msgid "Upgrade to [PRO]"
msgstr "Oppgrader til [PRO]"

msgid "Check PRO features of this extension on this extension's GitHub repo."
msgstr "Se PRO-funksjonene for denne utvidelsen i dens GitHub-depot."

msgid "Visit documentation on GitHub"
msgstr "Se dokumentasjon på GitHub"

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] WACK Shell-integrasjon"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "Installert. Aktiverer myke overganger og Cupertino-inspirerte skalltilpasninger."

msgid "Installed"
msgstr "Installert"

msgid "WACK Shell - Check for Updates"
msgstr "WACK Shell - Se etter oppdateringer"

msgid "Copy check command to verify if a newer version of WACK Shell is available."
msgstr "Kopier kommandoen for å sjekke om en nyere versjon av WACK Shell er tilgjengelig."

msgid "Copy update-check command to clipboard"
msgstr "Kopier oppdateringssjekk-kommando"

msgid "Copied WACK Shell update-check command to clipboard!"
msgstr "WACK Shell-oppdateringssjekkkommando kopiert til utklippstavlen!"

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "Ikke installert. Installer WACK Shell for å låse opp overgangseffekter."

msgid "Not Installed"
msgstr "Ikke installert"

msgid "WACK Shell - Install"
msgstr "WACK Shell - Installer"

msgid "Get advanced desktop crossfade transitions and Cupertino-inspired shell customisations. May contain bugs, report if found."
msgstr "Få avanserte myke skrivebordsoverganger og Cupertino-inspirerte skalltilpasninger. Kan inneholde feil; rapporter om du finner noen."

msgid "Copied WACK Shell install command to clipboard!"
msgstr "WACK Shell-installasjonskommando kopiert til utklippstavlen!"

msgid "Open WACK Shell repository"
msgstr "Åpne WACK Shell-depot"

msgid "Clear Visual Cache"
msgstr "Tøm visuell hurtigbuffer"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "Sletter midlertidige visuelle data som brukes til bakgrunnsbilder og visuelle effekter. De genereres automatisk på nytt."

msgid "Clear"
msgstr "Tøm"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "Tømmer den visuelle hurtigbufferen som brukes til bakgrunnsbilder og visuelle effekter"

msgid "Visual cache cleared successfully!"
msgstr "Visuell hurtigbuffer tømt!"

msgid "Failed to clear cache:"
msgstr "Kunne ikke tømme hurtigbuffer:"

