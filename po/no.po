msgstr "Full"

msgid "Cursor Blinking"
msgstr "Markørblinking"

msgid "Enable or disable text cursor blinking in the password field."
msgstr "Aktiver eller deaktiver markørblinking i passordfeltet."

msgid "Custom Lockscreen Wallpaper"
msgstr "Egendefinert bakgrunnsbilde for låseskjerm"

msgid "Use a custom image overlay for the lockscreen background."
msgstr "Bruk et egendefinert bilde som bakgrunn på låseskjermen."

msgid "Wallpaper Image Path"
msgstr "Bane for bakgrunnsbilde"

msgid "No image selected"
msgstr "Ingen bilde valgt"

