msgstr "การกำหนดค่า"

msgid "General"
msgstr "ทั่วไป"

msgid "Date Style"
msgstr "รูปแบบวันที่"

msgid "Choose between shortened and full date names."
msgstr "เลือกระหว่างชื่อวันที่แบบย่อหรือแบบเต็ม"

msgid "Short"
msgstr "สั้น"

msgid "Full"
msgstr "เต็ม"

msgid "Cursor Blinking"
msgstr "การกะพริบของเคอร์เซอร์"

msgid "Enable or disable text cursor blinking in the password field."
msgstr "เปิดหรือปิดใช้งานการกะพริบของเคอร์เซอร์ในช่องใส่รหัสผ่าน"

msgid "Custom Lockscreen Wallpaper"
msgstr "ภาพพื้นหลังหน้าจอล็อกแบบกำหนดเอง"

msgid "Use a custom image overlay for the lockscreen background."
msgstr "ใช้ภาพซ้อนทับแบบกำหนดเองสำหรับพื้นหลังหน้าจอล็อก"

msgid "Wallpaper Image Path"
msgstr "เส้นทางภาพพื้นหลัง"

msgid "No image selected"
msgstr "ไม่ได้เลือกภาพ"

msgid "Select Image File"
msgstr "เลือกไฟล์ภาพ"

msgid "Select Lockscreen Wallpaper"
msgstr "เลือกภาพพื้นหลังหน้าจอล็อก"

msgid "Select"
msgstr "เลือก"

msgid "Cancel"
msgstr "ยกเลิก"

msgid "Image Files"
msgstr "ไฟล์ภาพ"

msgid "Lockscreen Mode"
msgstr "โหมดหน้าจอล็อก"

msgid "Mode"
msgstr "โหมด"

msgid "Legacy"
msgstr "แบบดั้งเดิม"

msgid "Cupertino"
msgstr "คูเปอร์ติโน"

msgid "A complete macOS Sonoma-inspired lockscreen layout (Click user-icon to switch users)."
msgstr "เลย์เอาต์หน้าจอล็อกแบบสมบูรณ์ที่ได้รับแรงบันดาลใจจาก macOS Sonoma (คลิกไอคอนผู้ใช้เพื่อสลับผู้ใช้)"

msgid "macOS Sonoma-style clock over the classic, GNOME-compliant layout and flow."
msgstr "นาฬิกาสไตล์ macOS Sonoma บนเลย์เอาต์มาตรฐานของ GNOME"

msgid "Always Show User Widget"
msgstr "แสดงวิดเจ็ตผู้ใช้เสมอ"

msgid "Hides notifications by default. Press Shift+N to show notifications."
msgstr "ซ่อนการแจ้งเตือนตามค่าเริ่มต้น กด Shift+N เพื่อแสดงการแจ้งเตือน"

msgid "Prompt Vibrancy"
msgstr "เอฟเฟกต์ภาพของช่องรหัสผ่าน"

msgid "Adaptive color and depth enhancements for the password field."
msgstr "การปรับปรุงสีและความลึกแบบปรับได้สำหรับช่องใส่รหัสผ่าน"

msgid "Tonal"
msgstr "โทนสี"

msgid "Acrylic"
msgstr "อะคริลิก"

msgid "Lightweight, color-based mode."
msgstr "โหมดน้ำหนักเบาที่ใช้สี"

msgid "Advanced, blur-based mode."
msgstr "โหมดขั้นสูงที่ใช้การเบลอ"

msgid "Show message when locked"
msgstr "แสดงข้อความเมื่อล็อกหน้าจอ"

msgid "Set..."
msgstr "ตั้งค่า…"

msgid "Set a message to appear on the lockscreen"
msgstr "ตั้งค่าข้อความที่จะปรากฏบนหน้าจอล็อก"

msgid "OK"
msgstr "ตกลง"

msgid "Unlock Crossfade"
msgstr "การเฟดข้ามเมื่อปลดล็อก"

msgid "Crossfade the lockscreen with desktop when unlocking (automatically disabled in Power Saver mode)."
msgstr "เฟดข้ามหน้าจอล็อกกับเดสก์ท็อปเมื่อปลดล็อก (ปิดใช้งานอัตโนมัติในโหมดประหยัดพลังงาน)"

msgid "Requires WACK Shell to be installed and enabled."
msgstr "ต้องติดตั้งและเปิดใช้งาน WACK Shell"

msgid "Requires WACK Shell to be enabled."
msgstr "ต้องเปิดใช้งาน WACK Shell"

msgid "Crossfade Speed"
msgstr "ความเร็วการเฟดข้าม"

msgid "Slower"
msgstr "ช้าลง"

msgid "Faster"
msgstr "เร็วขึ้น"

msgid "Clock Animation"
msgstr "ภาพเคลื่อนไหวของนาฬิกา"

msgid "Applied to the date and time while opening the password prompt"
msgstr "ใช้กับวันที่และเวลาขณะเปิดกล่องใส่รหัสผ่าน"

msgid "Prompt Animation"
msgstr "ภาพเคลื่อนไหวกล่องข้อความยืนยันตัวตน"

msgid "Applied to the authentication prompt while it appears"
msgstr "ใช้กับกล่องข้อความยืนยันตัวตนขณะปรากฏขึ้น"

msgid "Reset Animations"
msgstr "รีเซ็ตภาพเคลื่อนไหว"

msgid "Restore defaults"
msgstr "คืนค่าเริ่มต้น"

msgid "Reset animations"
msgstr "รีเซ็ตภาพเคลื่อนไหว"

msgid "Scale Down"
msgstr "ย่อขนาด"

msgid "Zoom Up"
msgstr "ซูมขยาย"

msgid "Slide Up"
msgstr "เลื่อนขึ้น"

msgid "Fade"
msgstr "ค่อยๆ จางลง"

msgid "GNOME Default"
msgstr "ค่าเริ่มต้นของ GNOME"

msgid "Rise"
msgstr "ลอยขึ้น"

msgid "Zoom"
msgstr "ซูม"

msgid "Screen Timeout"
msgstr "การหมดเวลาหน้าจอ"

msgid "Display and Power"
msgstr "หน้าจอและพลังงาน"

msgid "Keep Screen On"
msgstr "เปิดหน้าจอค้างไว้"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "ป้องกันไม่ให้หน้าจอดับลงทันทีเมื่อล็อกหน้าจอ โดยหน้าจอจะยังคงดับลงหลังจากครบเวลาที่ตั้งไว้ในการตั้งค่าระบบ"

msgid "Only on AC Power"
msgstr "เฉพาะเมื่อเสียบปลั๊กไฟ (AC) เท่านั้น"

msgid "Only keep the screen on if the system is plugged in"
msgstr "เปิดหน้าจอค้างไว้เฉพาะเมื่ออุปกรณ์เสียบสายชาร์จอยู่เท่านั้น"

msgid "Escape to Sleep / Suspend"
msgstr "กด Escape เพื่อปิดหน้าจอ / พักเครื่อง"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "กด Escape บนหน้าจอล็อกเพื่อดับหน้าจอ (หรือพักเครื่อง)"

msgid "Extras"
msgstr "ฟังก์ชันเสริม"

msgid "Integrations"
msgstr "การผสานการทำงาน"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] GDM Expansion"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "สถานะ: เปิดใช้งานแล้ว เลย์เอาต์แบบกำหนดเองทำงานบน GDM"

msgid "Enabled"
msgstr "เปิดใช้งาน"

msgid "GDM Expansion - Remove"
msgstr "ส่วนขยาย GDM - ลบออก"

msgid "Revert GDM login screen layout to GNOME Default. To uninstall, run copied command in a terminal."
msgstr "เปลี่ยนเลย์เอาต์หน้าจอเข้าสู่ระบบ GDM กลับเป็นค่าเริ่มต้นของ GNOME ในการถอนการติดตั้ง ให้รันคำสั่งที่คัดลอกในเทอร์มินัล"

msgid "Copy uninstall command to clipboard"
msgstr "คัดลอกคำสั่งถอนการติดตั้งไปยังคลิปบอร์ด"

msgid "Copied uninstall command to clipboard!"
msgstr "คัดลอกคำสั่งถอนการติดตั้งไปยังคลิปบอร์ดแล้ว!"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "ไม่ได้ติดตั้งส่วนขยายทั่วทั้งระบบใน /usr/share"

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "โมดูลส่วนขยาย GDM (src/pro) ขาดหายไปในระบบ"

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "โหมดเซสชัน GDM ไม่ได้เปิดใช้งานในข้อมูลเมตาทั่วทั้งระบบ"

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "การกำหนดค่า dconf สำหรับ GDM (/etc/dconf/db/gdm.d) ขาดหายไป"

msgid "GDM integration is not configured."
msgstr "ไม่ได้กำหนดค่าการทำงานร่วมกับ GDM"

msgid "Status: Disabled."
msgstr "สถานะ: ปิดใช้งาน"

msgid "Disabled"
msgstr "ปิดใช้งาน"

msgid "Enable GDM DLC Support"
msgstr "เปิดใช้งานการรองรับ GDM DLC"

msgid "Click icon to copy installer command, then run it in a terminal."
msgstr "คลิกไอคอนเพื่อคัดลอกคำสั่งติดตั้ง จากนั้นรันในเทอร์มินัล"

msgid "Copy install command to clipboard"
msgstr "คัดลอกคำสั่งติดตั้งไปยังคลิปบอร์ด"

msgid "Copied install command to clipboard!"
msgstr "คัดลอกคำสั่งติดตั้งไปยังคลิปบอร์ดแล้ว!"

msgid "Upgrade to [PRO]"
msgstr "อัปเกรดเป็น [PRO]"

msgid "Check PRO features of this extension on this extension's GitHub repo."
msgstr "ดูคุณสมบัติ PRO ของส่วนขยายนี้บนพื้นที่เก็บข้อมูล GitHub"

msgid "Visit documentation on GitHub"
msgstr "ดูเอกสารคู่มือบน GitHub"

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] การผสานการทำงานกับ WACK Shell"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "ติดตั้งแล้ว เปิดใช้งานการเปลี่ยนภาพแบบเฟดข้ามและการปรับแต่งเชลล์สไตล์คูเปอร์ติโน"

msgid "Installed"
msgstr "ติดตั้งแล้ว"

msgid "WACK Shell - Check for Updates"
msgstr "WACK Shell - ตรวจสอบการอัปเดต"

msgid "Copy check command to verify if a newer version of WACK Shell is available."
msgstr "คัดลอกคำสั่งเพื่อตรวจสอบว่ามี WACK Shell เวอร์ชันใหม่กว่าหรือไม่"

msgid "Copy update-check command to clipboard"
msgstr "คัดลอกคำสั่งตรวจสอบการอัปเดต"

msgid "Copied WACK Shell update-check command to clipboard!"
msgstr "คัดลอกคำสั่งตรวจสอบการอัปเดต WACK Shell ไปยังคลิปบอร์ดแล้ว!"

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "ยังไม่ได้ติดตั้ง ติดตั้ง WACK Shell เพื่อปลดล็อกเอฟเฟกต์การเปลี่ยนภาพ"

msgid "Not Installed"
msgstr "ยังไม่ได้ติดตั้ง"

msgid "WACK Shell - Install"
msgstr "WACK Shell - ติดตั้ง"

msgid "Get advanced desktop crossfade transitions and Cupertino-inspired shell customisations. May contain bugs, report if found."
msgstr "รับการเปลี่ยนภาพแบบเฟดข้ามบนเดสก์ท็อปขั้นสูงและการปรับแต่งเชลล์สไตล์คูเปอร์ติโน อาจมีข้อผิดพลาด โปรดรายงานหากพบ"

msgid "Copied WACK Shell install command to clipboard!"
msgstr "คัดลอกคำสั่งติดตั้ง WACK Shell ไปยังคลิปบอร์ดแล้ว!"

msgid "Open WACK Shell repository"
msgstr "เปิดที่เก็บ WACK Shell"

msgid "Clear Visual Cache"
msgstr "ล้างแคชภาพ"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "ลบข้อมูลภาพชั่วคราวที่ใช้สำหรับภาพพื้นหลังและเอฟเฟกต์ภาพ ข้อมูลจะถูกสร้างขึ้นใหม่โดยอัตโนมัติ"

msgid "Clear"
msgstr "ล้าง"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "ล้างแคชภาพที่ใช้สำหรับภาพพื้นหลังและเอฟเฟกต์ภาพ"

msgid "Visual cache cleared successfully!"
msgstr "ล้างแคชภาพสำเร็จแล้ว!"

msgid "Failed to clear cache:"
msgstr "ไม่สามารถล้างแคชได้:"

