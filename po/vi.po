msgstr "Mở Saweria"

msgid "Configuration"
msgstr "Cấu hình"

msgid "General"
msgstr "Chung"

msgid "Date Style"
msgstr "Kiểu ngày"

msgid "Choose between shortened and full date names."
msgstr "Chọn giữa tên ngày viết tắt và đầy đủ."

msgid "Short"
msgstr "Ngắn"

msgid "Full"
msgstr "Đầy đủ"

msgid "Cursor Blinking"
msgstr "Con trỏ nhấp nháy"

msgid "Enable or disable text cursor blinking in the password field."
msgstr "Bật hoặc tắt con trỏ nhấp nháy trong ô nhập mật khẩu."

msgid "Custom Lockscreen Wallpaper"
msgstr "Hình nền màn hình khóa tùy chỉnh"

msgid "Use a custom image overlay for the lockscreen background."
msgstr "Sử dụng hình ảnh tùy chỉnh làm nền màn hình khóa."

msgid "Wallpaper Image Path"
msgstr "Đường dẫn hình nền"

msgid "No image selected"
msgstr "Chưa chọn hình ảnh"

msgid "Select Image File"
msgstr "Chọn tệp hình ảnh"

msgid "Select Lockscreen Wallpaper"
msgstr "Chọn hình nền màn hình khóa"

msgid "Select"
msgstr "Chọn"

msgid "Cancel"
msgstr "Hủy"

msgid "Image Files"
msgstr "Tệp hình ảnh"

msgid "Lockscreen Mode"
msgstr "Chế độ màn hình khóa"

msgid "Mode"
msgstr "Chế độ"

msgid "Legacy"
msgstr "Cổ điển"

msgid "Cupertino"
msgstr "Cupertino"

msgid "A complete macOS Sonoma-inspired lockscreen layout (Click user-icon to switch users)."
msgstr "Bố cục màn hình khóa hoàn chỉnh lấy cảm hứng từ macOS Sonoma (nhấp vào biểu tượng người dùng để chuyển đổi người dùng)."

msgid "macOS Sonoma-style clock over the classic, GNOME-compliant layout and flow."
msgstr "Đồng hồ phong cách macOS Sonoma trên bố cục chuẩn truyền thống của GNOME."

msgid "Always Show User Widget"
msgstr "Luôn hiển thị tiện ích người dùng"

msgid "Hides notifications by default. Press Shift+N to show notifications."
msgstr "Ẩn thông báo theo mặc định. Nhấn Shift+N để hiển thị thông báo."

msgid "Prompt Vibrancy"
msgstr "Hiệu ứng thị giác cho ô nhập mật khẩu"

msgid "Adaptive color and depth enhancements for the password field."
msgstr "Cải thiện màu sắc và chiều sâu thích ứng cho ô nhập mật khẩu."

msgid "Tonal"
msgstr "Tông màu"

msgid "Acrylic"
msgstr "Acrylic"

msgid "Lightweight, color-based mode."
msgstr "Chế độ nhẹ dựa trên màu sắc."

msgid "Advanced, blur-based mode."
msgstr "Chế độ nâng cao dựa trên làm mờ."

msgid "Show message when locked"
msgstr "Hiển thị tin nhắn khi khóa"

msgid "Set..."
msgstr "Đặt…"

msgid "Set a message to appear on the lockscreen"
msgstr "Đặt tin nhắn xuất hiện trên màn hình khóa"

msgid "OK"
msgstr "OK"

msgid "Unlock Crossfade"
msgstr "Làm mờ chuyển tiếp khi mở khóa"

msgid "Crossfade the lockscreen with desktop when unlocking (automatically disabled in Power Saver mode)."
msgstr "Làm mờ chuyển tiếp màn hình khóa với màn hình nền khi mở khóa (tự động tắt ở chế độ tiết kiệm pin)."

msgid "Requires WACK Shell to be installed and enabled."
msgstr "Yêu cầu cài đặt và bật WACK Shell."

msgid "Requires WACK Shell to be enabled."
msgstr "Yêu cầu bật WACK Shell."

msgid "Crossfade Speed"
msgstr "Tốc độ làm mờ"

msgid "Slower"
msgstr "Chậm hơn"

msgid "Faster"
msgstr "Nhanh hơn"

msgid "Clock Animation"
msgstr "Hiệu ứng chuyển động đồng hồ"

msgid "Applied to the date and time while opening the password prompt"
msgstr "Áp dụng cho ngày và giờ trong khi mở khung nhập mật khẩu"

msgid "Prompt Animation"
msgstr "Hiệu ứng khung xác thực"

msgid "Applied to the authentication prompt while it appears"
msgstr "Áp dụng cho khung xác thực khi xuất hiện"

msgid "Reset Animations"
msgstr "Đặt lại hiệu ứng chuyển động"

msgid "Restore defaults"
msgstr "Khôi phục mặc định"

msgid "Reset animations"
msgstr "Đặt lại hiệu ứng"

msgid "Scale Down"
msgstr "Thu nhỏ"

msgid "Zoom Up"
msgstr "Phóng to"

msgid "Slide Up"
msgstr "Trượt lên"

msgid "Fade"
msgstr "Làm mờ dần"

msgid "GNOME Default"
msgstr "Mặc định của GNOME"

msgid "Rise"
msgstr "Nổi lên"

msgid "Zoom"
msgstr "Thu phóng"

msgid "Screen Timeout"
msgstr "Thời gian chờ màn hình"

msgid "Display and Power"
msgstr "Màn hình và nguồn điện"

msgid "Keep Screen On"
msgstr "Giữ màn hình luôn bật"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "Ngăn màn hình tắt ngay khi khóa. Màn hình vẫn sẽ tắt sau khoảng thời gian chờ thông thường được cài đặt trong cài đặt hệ thống."

msgid "Only on AC Power"
msgstr "Chỉ khi cắm nguồn điện AC"

msgid "Only keep the screen on if the system is plugged in"
msgstr "Chỉ giữ màn hình luôn bật nếu thiết bị đang cắm sạc"

msgid "Escape to Sleep / Suspend"
msgstr "Nhấn Escape để tắt màn hình / tạm dừng"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "Nhấn Escape trên màn hình khóa để tắt hiển thị (hoặc tạm dừng hệ thống)"

msgid "Extras"
msgstr "Tính năng bổ sung"

msgid "Integrations"
msgstr "Tích hợp"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] GDM Expansion"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "Trạng thái: Đã bật. Bố cục tùy chỉnh đang hoạt động trên GDM."

msgid "Enabled"
msgstr "Đã bật"

msgid "GDM Expansion - Remove"
msgstr "Mở rộng GDM - Gỡ cài đặt"

msgid "Revert GDM login screen layout to GNOME Default. To uninstall, run copied command in a terminal."
msgstr "Khôi phục bố cục màn hình đăng nhập GDM về mặc định của GNOME. Để gỡ cài đặt, hãy chạy lệnh đã sao chép trong cửa sổ dòng lệnh (terminal)."

msgid "Copy uninstall command to clipboard"
msgstr "Sao chép lệnh gỡ cài đặt vào bộ nhớ tạm"

msgid "Copied uninstall command to clipboard!"
msgstr "Đã sao chép lệnh gỡ cài đặt vào bộ nhớ tạm!"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "Tiện ích mở rộng chưa được cài đặt trên toàn hệ thống trong /usr/share."

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "Thiếu các mô-đun mở rộng GDM (src/pro) trên toàn hệ thống."

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "Chế độ phiên GDM chưa được bật trong siêu dữ liệu toàn hệ thống."

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "Thiếu cấu hình ghi đè dconf của GDM (/etc/dconf/db/gdm.d)."

msgid "GDM integration is not configured."
msgstr "Tích hợp GDM chưa được cấu hình."

msgid "Status: Disabled."
msgstr "Trạng thái: Đã tắt."

msgid "Disabled"
msgstr "Đã tắt"

msgid "Enable GDM DLC Support"
msgstr "Bật hỗ trợ DLC GDM"

msgid "Click icon to copy installer command, then run it in a terminal."
msgstr "Nhấp vào biểu tượng để sao chép lệnh cài đặt, sau đó chạy lệnh đó trong terminal."

msgid "Copy install command to clipboard"
msgstr "Sao chép lệnh cài đặt vào bộ nhớ tạm"

msgid "Copied install command to clipboard!"
msgstr "Đã sao chép lệnh cài đặt vào bộ nhớ tạm!"

msgid "Upgrade to [PRO]"
msgstr "Nâng cấp lên [PRO]"

msgid "Check PRO features of this extension on this extension's GitHub repo."
msgstr "Xem các tính năng PRO của tiện ích mở rộng này trên kho lưu trữ GitHub."

msgid "Visit documentation on GitHub"
msgstr "Xem tài liệu trên GitHub"

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] Tích hợp WACK Shell"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "Đã cài đặt. Kích hoạt hiệu ứng làm mờ chuyển tiếp và tùy biến Shell phong cách Cupertino."

msgid "Installed"
msgstr "Đã cài đặt"

msgid "WACK Shell - Check for Updates"
msgstr "WACK Shell - Kiểm tra cập nhật"

msgid "Copy check command to verify if a newer version of WACK Shell is available."
msgstr "Sao chép lệnh để kiểm tra xem có phiên bản WACK Shell mới hơn hay không."

msgid "Copy update-check command to clipboard"
msgstr "Sao chép lệnh kiểm tra cập nhật"

msgid "Copied WACK Shell update-check command to clipboard!"
msgstr "Đã sao chép lệnh kiểm tra cập nhật WACK Shell vào bộ nhớ tạm!"

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "Chưa cài đặt. Hãy cài đặt WACK Shell để mở khóa các hiệu ứng chuyển tiếp."

msgid "Not Installed"
msgstr "Chưa cài đặt"

msgid "WACK Shell - Install"
msgstr "WACK Shell - Cài đặt"

msgid "Get advanced desktop crossfade transitions and Cupertino-inspired shell customisations. May contain bugs, report if found."
msgstr "Nhận các hiệu ứng làm mờ chuyển tiếp nâng cao và tùy biến Shell phong cách Cupertino. Có thể có lỗi, vui lòng báo cáo nếu gặp."

msgid "Copied WACK Shell install command to clipboard!"
msgstr "Đã sao chép lệnh cài đặt WACK Shell vào bộ nhớ tạm!"

msgid "Open WACK Shell repository"
msgstr "Mở kho lưu trữ WACK Shell"

msgid "Clear Visual Cache"
msgstr "Xóa bộ nhớ đệm hình ảnh"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "Xóa dữ liệu hình ảnh tạm thời dùng cho hình nền và hiệu ứng thị giác. Dữ liệu sẽ được tự động tạo lại khi cần."

msgid "Clear"
msgstr "Xóa"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "Xóa bộ nhớ đệm hình ảnh được sử dụng cho hình nền và hiệu ứng thị giác"

msgid "Visual cache cleared successfully!"
msgstr "Đã xóa bộ nhớ đệm hình ảnh thành công!"

msgid "Failed to clear cache:"
msgstr "Không thể xóa bộ nhớ đệm:"

