msgstr "الإعدادات"

msgid "General"
msgstr "عام"

msgid "Date Style"
msgstr "نمط التاريخ"

msgid "Choose between shortened and full date names."
msgstr "اختر بين أسماء التواريخ المختصرة والكاملة."

msgid "Short"
msgstr "مختصر"

msgid "Full"
msgstr "كامل"

msgid "Cursor Blinking"
msgstr "وميض المؤشر"

msgid "Enable or disable text cursor blinking in the password field."
msgstr "تفعيل أو تعطيل وميض المؤشر في حقل كلمة المرور."

msgid "Custom Lockscreen Wallpaper"
msgstr "خلفية مخصصة لشاشة القفل"

msgid "Use a custom image overlay for the lockscreen background."
msgstr "استخدام صورة مخصصة كخلفية لشاشة القفل."

msgid "Wallpaper Image Path"
msgstr "مسار صورة الخلفية"

msgid "No image selected"
msgstr "لم يتم تحديد أي صورة"

msgid "Select Image File"
msgstr "تحديد ملف صورة"

msgid "Select Lockscreen Wallpaper"
msgstr "تحديد خلفية شاشة القفل"

msgid "Select"
msgstr "تحديد"

msgid "Cancel"
msgstr "إلغاء"

msgid "Image Files"
msgstr "ملفات الصور"

msgid "Lockscreen Mode"
msgstr "وضع شاشة القفل"

msgid "Mode"
msgstr "الوضع"

msgid "Legacy"
msgstr "تقليدي"

msgid "Cupertino"
msgstr "كوبرتينو"

msgid "A complete macOS Sonoma-inspired lockscreen layout (Click user-icon to switch users)."
msgstr "تخطيط كامل لشاشة القفل مستوحى من macOS Sonoma (انقر فوق أيقونة المستخدم لتبديل المستخدمين)."

msgid "macOS Sonoma-style clock over the classic, GNOME-compliant layout and flow."
msgstr "ساعة بنمط macOS Sonoma مع تخطيط وسير العمل الكلاسيكي المتوافق مع GNOME."

msgid "Always Show User Widget"
msgstr "إظهار عنصر واجهة المستخدم دائمًا"

msgid "Hides notifications by default. Press Shift+N to show notifications."
msgstr "يخفي الإشعارات افتراضيًا. اضغط على Shift+N لإظهارها."

msgid "Prompt Vibrancy"
msgstr "المظهر البصري لحقل كلمة المرور"

msgid "Adaptive color and depth enhancements for the password field."
msgstr "تحسينات تكيفية للون والعمق لحقل كلمة المرور."

msgid "Tonal"
msgstr "لوني"

msgid "Acrylic"
msgstr "أكريليك"

msgid "Lightweight, color-based mode."
msgstr "وضع خفيف يعتمد على الألوان."

msgid "Advanced, blur-based mode."
msgstr "وضع متقدم يعتمد على التمويه."

msgid "Show message when locked"
msgstr "إظهار رسالة عند القفل"

msgid "Set..."
msgstr "تعيين…"

msgid "Set a message to appear on the lockscreen"
msgstr "تعيين رسالة لتظهر على شاشة القفل"

msgid "OK"
msgstr "موافق"

msgid "Unlock Crossfade"
msgstr "التلاشي التدريجي عند إلغاء القفل"

msgid "Crossfade the lockscreen with desktop when unlocking (automatically disabled in Power Saver mode)."
msgstr "تلاشٍ تدريجي بين شاشة القفل وسطح المكتب عند إلغاء القفل (يتم تعطيله تلقائيًا في وضع توفير الطاقة)."

msgid "Requires WACK Shell to be installed and enabled."
msgstr "يتطلب تثبيت WACK Shell وتفعيله."

msgid "Requires WACK Shell to be enabled."
msgstr "يتطلب تفعيل WACK Shell."

msgid "Crossfade Speed"
msgstr "سرعة التلاشي التدريجي"

msgid "Slower"
msgstr "أبطأ"

msgid "Faster"
msgstr "أسرع"

msgid "Clock Animation"
msgstr "حركة الساعة"

msgid "Applied to the date and time while opening the password prompt"
msgstr "تُطبق على التاريخ والوقت أثناء فتح حقل كلمة المرور"

msgid "Prompt Animation"
msgstr "حركة حقل المصادقة"

msgid "Applied to the authentication prompt while it appears"
msgstr "تُطبق على حقل المصادقة أثناء ظهوره"

msgid "Reset Animations"
msgstr "إعادة تعيين الحركات"

msgid "Restore defaults"
msgstr "استعادة الإعدادات الافتراضية"

msgid "Reset animations"
msgstr "إعادة تعيين الحركات"

msgid "Scale Down"
msgstr "تصغير"

msgid "Zoom Up"
msgstr "تكبير"

msgid "Slide Up"
msgstr "سحب للأعلى"

msgid "Fade"
msgstr "تلاشي"

msgid "GNOME Default"
msgstr "افتراضي GNOME"

msgid "Rise"
msgstr "صعود"

msgid "Zoom"
msgstr "تكبير"

msgid "Screen Timeout"
msgstr "مهلة إيقاف الشاشة"

msgid "Display and Power"
msgstr "الشاشة والطاقة"

msgid "Keep Screen On"
msgstr "إبقاء الشاشة قيد التشغيل"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "يمنع إيقاف تشغيل الشاشة فورًا عند القفل. ستنطفئ الشاشة بعد انتهاء المهلة المعتادة المحددة في إعدادات النظام."

msgid "Only on AC Power"
msgstr "فقط عند الاتصال بمصدر طاقة"

msgid "Only keep the screen on if the system is plugged in"
msgstr "إبقاء الشاشة قيد التشغيل فقط إذا كان الجهاز متصلاً بالكهرباء"

msgid "Escape to Sleep / Suspend"
msgstr "Escape لإطفاء الشاشة / التعليق"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "اضغط على Escape في شاشة القفل لإطفاء الشاشة (أو تعليق النظام)"

msgid "Extras"
msgstr "إضافات"

msgid "Integrations"
msgstr "عمليات التكامل"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] GDM Expansion"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "الحالة: مفعّل. التخطيط المخصص نشط على GDM."

msgid "Enabled"
msgstr "مفعّل"

msgid "GDM Expansion - Remove"
msgstr "توسعة GDM - إزالة"

msgid "Revert GDM login screen layout to GNOME Default. To uninstall, run copied command in a terminal."
msgstr "استعادة تخطيط شاشة تسجيل الدخول في GDM إلى الوضع الافتراضي لـ GNOME. لإلغاء التثبيت، شغّل الأمر المنسوخ في الطرفية."

msgid "Copy uninstall command to clipboard"
msgstr "نسخ أمر إلغاء التثبيت إلى الحافظة"

msgid "Copied uninstall command to clipboard!"
msgstr "تم نسخ أمر إلغاء التثبيت إلى الحافظة!"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "الامتداد غير مثبت على مستوى النظام في /usr/share."

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "وحدات توسعة GDM (src/pro) مفقودة على مستوى النظام."

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "وضع جلسة GDM غير مفعّل في بيانات التعريف على مستوى النظام."

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "تكوين تجاوز dconf لـ GDM (/etc/dconf/db/gdm.d) مفقود."

msgid "GDM integration is not configured."
msgstr "تكامل GDM غير مهيأ."

msgid "Status: Disabled."
msgstr "الحالة: معطّل."

msgid "Disabled"
msgstr "معطّل"

msgid "Enable GDM DLC Support"
msgstr "تفعيل دعم GDM DLC"

msgid "Click icon to copy installer command, then run it in a terminal."
msgstr "انقر على الأيقونة لنسخ أمر التثبيت، ثم شغّله في الطرفية."

msgid "Copy install command to clipboard"
msgstr "نسخ أمر التثبيت إلى الحافظة"

msgid "Copied install command to clipboard!"
msgstr "تم نسخ أمر التثبيت إلى الحافظة!"

msgid "Upgrade to [PRO]"
msgstr "الترقية إلى [PRO]"

msgid "Check PRO features of this extension on this extension's GitHub repo."
msgstr "تحقق من ميزات PRO لهذا الامتداد في مستودع GitHub الخاص به."

msgid "Visit documentation on GitHub"
msgstr "زيارة التوثيق على GitHub"

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] تكامل WACK Shell"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "مثبّت. يتيح انتقالات التلاشي التدريجي وتخصيصات الواجهة المستوحاة من Cupertino."

msgid "Installed"
msgstr "مثبّت"

msgid "WACK Shell - Check for Updates"
msgstr "WACK Shell - التحقق من وجود تحديثات"

msgid "Copy check command to verify if a newer version of WACK Shell is available."
msgstr "انسخ الأمر للتحقق مما إذا كان هناك إصدار أحدث من WACK Shell متاحًا."

msgid "Copy update-check command to clipboard"
msgstr "نسخ أمر التحقق من التحديث"

msgid "Copied WACK Shell update-check command to clipboard!"
msgstr "تم نسخ أمر التحقق من تحديث WACK Shell إلى الحافظة!"

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "غير مثبّت. قم بتثبيت WACK Shell لإلغاء قفل تأثيرات الانتقال."

msgid "Not Installed"
msgstr "غير مثبّت"

msgid "WACK Shell - Install"
msgstr "WACK Shell - تثبيت"

msgid "Get advanced desktop crossfade transitions and Cupertino-inspired shell customisations. May contain bugs, report if found."
msgstr "احصل على انتقالات تلاشٍ متقدمة وتخصيصات للواجهة مستوحاة من Cupertino. قد يحتوي على أخطاء، يُرجى الإبلاغ عنها إذا وجدتها."

msgid "Copied WACK Shell install command to clipboard!"
msgstr "تم نسخ أمر تثبيت WACK Shell إلى الحافظة!"

msgid "Open WACK Shell repository"
msgstr "فتح مستودع WACK Shell"

msgid "Clear Visual Cache"
msgstr "مسح الذاكرة المؤقتة للرسومات"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "يمسح البيانات الرسومية المؤقتة المستخدمة للخلفيات وتأثيرات المظهر البصري. ستتم إعادة إنشائها تلقائيًا."

msgid "Clear"
msgstr "مسح"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "يمسح الذاكرة المؤقتة للرسومات المستخدمة للخلفيات وتأثيرات المظهر البصري"

msgid "Visual cache cleared successfully!"
msgstr "تم مسح الذاكرة المؤقتة للرسومات بنجاح!"

msgid "Failed to clear cache:"
msgstr "فشل مسح الذاكرة المؤقتة:"

