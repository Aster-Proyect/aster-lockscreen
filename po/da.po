msgstr "Generelt"

msgid "Date Style"
msgstr "Datostil"

msgid "Choose between shortened and full date names."
msgstr "Vælg mellem forkortede og fulde datonavne."

msgid "Short"
msgstr "Kort"

msgid "Full"
msgstr "Fuld"

msgid "Cursor Blinking"
msgstr "Markørblink"

msgid "Enable or disable text cursor blinking in the password field."
msgstr "Aktivér eller deaktivér markørblink i adgangskodefeltet."

msgid "Custom Lockscreen Wallpaper"
msgstr "Brugerdefineret baggrundsbillede for låseskærm"

msgid "Use a custom image overlay for the lockscreen background."
msgstr "Brug et brugerdefineret billede som baggrund på låseskærmen."

msgid "Wallpaper Image Path"
msgstr "Sti til baggrundsbillede"

msgid "No image selected"
msgstr "Intet billede valgt"

msgid "Select Image File"
msgstr "Vælg billedfil"

msgid "Select Lockscreen Wallpaper"
msgstr "Vælg baggrundsbillede for låseskærm"

msgid "Select"
msgstr "Vælg"

msgid "Cancel"
msgstr "Annuller"

msgid "Image Files"
msgstr "Billedfiler"

msgid "Lockscreen Mode"
msgstr "Låseskærmstilstand"

msgid "Mode"
msgstr "Tilstand"

msgid "Legacy"
msgstr "Klassisk"

msgid "Cupertino"
msgstr "Cupertino"

msgid "A complete macOS Sonoma-inspired lockscreen layout (Click user-icon to switch users)."
msgstr "Et komplet macOS Sonoma-inspireret låseskærmslayout (klik på brugerikonet for at skifte bruger)."

msgid "macOS Sonoma-style clock over the classic, GNOME-compliant layout and flow."
msgstr "macOS Sonoma-lignende ur over det klassiske, GNOME-kompatible layout."

msgid "Always Show User Widget"
msgstr "Vis altid brugerwidgetten"

msgid "Hides notifications by default. Press Shift+N to show notifications."
msgstr "Skjuler notifikationer som standard. Tryk på Shift+N for at vise dem."

msgid "Prompt Vibrancy"
msgstr "Visuel effekt for adgangskodefeltet"

msgid "Adaptive color and depth enhancements for the password field."
msgstr "Adaptive farve- og dybdeforbedringer for adgangskodefeltet."

msgid "Tonal"
msgstr "Tonal"

msgid "Acrylic"
msgstr "Akryl"

msgid "Lightweight, color-based mode."
msgstr "Letvægts-, farvebaseret tilstand."

msgid "Advanced, blur-based mode."
msgstr "Avanceret, sløringsbaseret tilstand."

msgid "Show message when locked"
msgstr "Vis besked ved låsning"

msgid "Set..."
msgstr "Indstil…"

msgid "Set a message to appear on the lockscreen"
msgstr "Indstil en besked, der skal vises på låseskærmen"

msgid "OK"
msgstr "OK"

msgid "Unlock Crossfade"
msgstr "Krydsudtoning ved oplåsning"

msgid "Crossfade the lockscreen with desktop when unlocking (automatically disabled in Power Saver mode)."
msgstr "Krydsudtoning mellem låseskærm og skrivebord ved oplåsning (deaktiveres automatisk i strømsparetilstand)."

msgid "Requires WACK Shell to be installed and enabled."
msgstr "Kræver, at WACK Shell er installeret og aktiveret."

msgid "Requires WACK Shell to be enabled."
msgstr "Kræver, at WACK Shell er aktiveret."

msgid "Crossfade Speed"
msgstr "Overgangshastighed"

msgid "Slower"
msgstr "Langsommere"

msgid "Faster"
msgstr "Hurtigere"

msgid "Clock Animation"
msgstr "Uranimation"

msgid "Applied to the date and time while opening the password prompt"
msgstr "Anvendes på dato og klokkeslæt, når adgangskodefeltet åbnes"

msgid "Prompt Animation"
msgstr "Godkendelsesanimation"

msgid "Applied to the authentication prompt while it appears"
msgstr "Anvendes på godkendelsesfeltet, når det vises"

msgid "Reset Animations"
msgstr "Nulstil animationer"

msgid "Restore defaults"
msgstr "Gendan standardindstillinger"

msgid "Reset animations"
msgstr "Nulstil animationer"

msgid "Scale Down"
msgstr "Formindsk"

msgid "Zoom Up"
msgstr "Forstør"

msgid "Slide Up"
msgstr "Skub opad"

msgid "Fade"
msgstr "Tone"

msgid "GNOME Default"
msgstr "GNOME-standard"

msgid "Rise"
msgstr "Løft"

msgid "Zoom"
msgstr "Zoom"

msgid "Screen Timeout"
msgstr "Skærmtimeout"

msgid "Display and Power"
msgstr "Skærm og strøm"

msgid "Keep Screen On"
msgstr "Hold skærmen tændt"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "Forhindrer, at skærmen slukker med det samme ved låsning. Skærmen slukker efter den normale tidsgrænse angivet i systemindstillingerne."

msgid "Only on AC Power"
msgstr "Kun ved tilsluttet strøm"

msgid "Only keep the screen on if the system is plugged in"
msgstr "Hold kun skærmen tændt, hvis computeren er tilsluttet strøm"

msgid "Escape to Sleep / Suspend"
msgstr "Escape for at slukke skærm / hviletilstand"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "Tryk på Escape på låseskærmen for at slukke skærmen (eller gå i hviletilstand)"

msgid "Extras"
msgstr "Ekstra"

msgid "Integrations"
msgstr "Integrationer"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] GDM Expansion"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "Status: Aktiveret. Det brugerdefinerede layout er aktivt på GDM."

msgid "Enabled"
msgstr "Aktiveret"

msgid "GDM Expansion - Remove"
msgstr "GDM-udvidelse - Fjern"

msgid "Revert GDM login screen layout to GNOME Default. To uninstall, run copied command in a terminal."
msgstr "Nulstil GDM-loginskærmen til GNOME-standard. Kør den kopierede kommando i en terminal for at afinstallere."

msgid "Copy uninstall command to clipboard"
msgstr "Kopier afinstallationskommando til udklipsholder"

msgid "Copied uninstall command to clipboard!"
msgstr "Afinstallationskommando kopieret til udklipsholder!"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "Udvidelsen er ikke installeret systemdækkende i /usr/share."

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "GDM-udvidelsesmoduler (src/pro) mangler systemdækkende."

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "GDM-sessionstilstand er ikke aktiveret i systemmetadata."

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "GDM dconf-tilsidesættelseskonfiguration (/etc/dconf/db/gdm.d) mangler."

msgid "GDM integration is not configured."
msgstr "GDM-integration er ikke konfigureret."

msgid "Status: Disabled."
msgstr "Status: Deaktiveret."

msgid "Disabled"
msgstr "Deaktiveret"

msgid "Enable GDM DLC Support"
msgstr "Aktivér GDM DLC-understøttelse"

msgid "Click icon to copy installer command, then run it in a terminal."
msgstr "Klik på ikonet for at kopiere installationskommandoen, og kør den derefter i en terminal."

msgid "Copy install command to clipboard"
msgstr "Kopier installationskommando til udklipsholder"

msgid "Copied install command to clipboard!"
msgstr "Installationskommando kopieret til udklipsholder!"

msgid "Upgrade to [PRO]"
msgstr "Opgrader til [PRO]"

msgid "Check PRO features of this extension on this extension's GitHub repo."
msgstr "Se PRO-funktionerne for denne udvidelse i dens GitHub-arkiv."

msgid "Visit documentation on GitHub"
msgstr "Se dokumentation på GitHub"

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] WACK Shell-integration"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "Installeret. Aktiverer udtoningsovergange og Cupertino-inspirerede shell-tilpasninger."

msgid "Installed"
msgstr "Installeret"

msgid "WACK Shell - Check for Updates"
msgstr "WACK Shell - Søg efter opdateringer"

msgid "Copy check command to verify if a newer version of WACK Shell is available."
msgstr "Kopier kommandoen for at kontrollere, om en nyere version af WACK Shell er tilgængelig."

msgid "Copy update-check command to clipboard"
msgstr "Kopier opdateringstjek-kommando"

msgid "Copied WACK Shell update-check command to clipboard!"
msgstr "WACK Shell-opdateringstjekkommando kopieret til udklipsholder!"

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "Ikke installeret. Installer WACK Shell for at låse op for overgangseffekter."

msgid "Not Installed"
msgstr "Ikke installeret"

msgid "WACK Shell - Install"
msgstr "WACK Shell - Installer"

msgid "Get advanced desktop crossfade transitions and Cupertino-inspired shell customisations. May contain bugs, report if found."
msgstr "Få avancerede udtoningsovergange på skrivebordet og Cupertino-inspirerede shell-tilpasninger. Kan indeholde fejl; rapportér hvis fundet."

msgid "Copied WACK Shell install command to clipboard!"
msgstr "WACK Shell-installationskommando kopieret til udklipsholder!"

msgid "Open WACK Shell repository"
msgstr "Åbn WACK Shell-arkiv"

msgid "Clear Visual Cache"
msgstr "Ryd visuel cache"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "Rydder midlertidige visuelle data, der bruges til baggrundsbilleder og visuelle effekter. De gendannes automatisk."

msgid "Clear"
msgstr "Ryd"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "Rydder den visuelle cache, der bruges til baggrundsbilleder og visuelle effekter"

msgid "Visual cache cleared successfully!"
msgstr "Visuel cache blev ryddet!"

msgid "Failed to clear cache:"
msgstr "Kunne ikke rydde cache:"

