msgstr "Complet"

msgid "Cursor Blinking"
msgstr "Clignotement du curseur"

msgid "Enable or disable text cursor blinking in the password field."
msgstr "Active ou désactive le clignotement du curseur dans le champ de mot de passe."

msgid "Custom Lockscreen Wallpaper"
msgstr "Fond d'écran de verrouillage personnalisé"

msgid "Use a custom image overlay for the lockscreen background."
msgstr "Utilise une image personnalisée pour l'arrière-plan de l'écran de verrouillage."

msgid "Wallpaper Image Path"
msgstr "Chemin de l'image d'arrière-plan"

msgid "No image selected"
msgstr "Aucune image sélectionnée"

msgid "Select Image File"
msgstr "Sélectionner un fichier image"

msgid "Select Lockscreen Wallpaper"
msgstr "Sélectionner le fond d'écran de verrouillage"

msgid "Select"
msgstr "Sélectionner"

msgid "Cancel"
msgstr "Annuler"

msgid "Image Files"
msgstr "Fichiers image"

msgid "Lockscreen Mode"
msgstr "Mode d'écran de verrouillage"

msgid "Mode"
msgstr "Mode"

msgid "Legacy"
msgstr "Classique"

msgid "Cupertino"
msgstr "Cupertino"

msgid "A complete macOS Sonoma-inspired lockscreen layout (Click user-icon to switch users)."
msgstr "Disposition complète inspirée de macOS Sonoma (cliquez sur l'icône d'utilisateur pour changer d'utilisateur)."

msgid "macOS Sonoma-style clock over the classic, GNOME-compliant layout and flow."
msgstr "Horloge style macOS Sonoma sur la disposition et le flux classiques de GNOME."

msgid "Always Show User Widget"
msgstr "Toujours afficher le widget utilisateur"

msgid "Hides notifications by default. Press Shift+N to show notifications."
msgstr "Masque les notifications par défaut. Appuyez sur Maj+N pour les afficher."

msgid "Prompt Vibrancy"
msgstr "Rendu visuel du champ de mot de passe"

msgid "Adaptive color and depth enhancements for the password field."
msgstr "Améliorations adaptatives de couleur et de profondeur pour le champ de mot de passe."

msgid "Tonal"
msgstr "Tonal"

msgid "Acrylic"
msgstr "Acrylique"

msgid "Lightweight, color-based mode."
msgstr "Mode léger basé sur la couleur."

msgid "Advanced, blur-based mode."
msgstr "Mode avancé basé sur le flou."

msgid "Show message when locked"
msgstr "Afficher un message lors du verrouillage"

msgid "Set..."
msgstr "Définir…"

msgid "Set a message to appear on the lockscreen"
msgstr "Définir un message à afficher sur l'écran de verrouillage"

msgid "OK"
msgstr "Valider"

msgid "Unlock Crossfade"
msgstr "Fondu au déverrouillage"

msgid "Crossfade the lockscreen with desktop when unlocking (automatically disabled in Power Saver mode)."
msgstr "Effectue un fondu entre l'écran de verrouillage et le bureau lors du déverrouillage (automatiquement désactivé en mode économie d'énergie)."

msgid "Requires WACK Shell to be installed and enabled."
msgstr "Nécessite que WACK Shell soit installé et activé."

msgid "Requires WACK Shell to be enabled."
msgstr "Nécessite que WACK Shell soit activé."

msgid "Crossfade Speed"
msgstr "Vitesse du fondu"

msgid "Slower"
msgstr "Plus lent"

msgid "Faster"
msgstr "Plus rapide"

msgid "Clock Animation"
msgstr "Animation de l'horloge"

msgid "Applied to the date and time while opening the password prompt"
msgstr "Appliquée à la date et à l'heure lors de l'ouverture du champ de mot de passe"

msgid "Prompt Animation"
msgstr "Animation du champ d'authentification"

msgid "Applied to the authentication prompt while it appears"
msgstr "Appliquée au champ d'authentification lors de son apparition"

msgid "Reset Animations"
msgstr "Réinitialiser les animations"

msgid "Restore defaults"
msgstr "Restaurer les valeurs par défaut"

msgid "Reset animations"
msgstr "Réinitialiser les animations"

msgid "Scale Down"
msgstr "Réduction d'échelle"

msgid "Zoom Up"
msgstr "Agrandissement"

msgid "Slide Up"
msgstr "Glissement vers le haut"

msgid "Fade"
msgstr "Fondu"

msgid "GNOME Default"
msgstr "GNOME par défaut"

msgid "Rise"
msgstr "Élévation"

msgid "Zoom"
msgstr "Zoom"

msgid "Screen Timeout"
msgstr "Délai d'extinction de l'écran"

msgid "Display and Power"
msgstr "Écran et énergie"

msgid "Keep Screen On"
msgstr "Garder l'écran allumé"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "Empêche l'écran de s'éteindre immédiatement lors du verrouillage. L'écran s'éteindra après le délai habituel défini dans les paramètres système."

msgid "Only on AC Power"
msgstr "Uniquement sur secteur"

msgid "Only keep the screen on if the system is plugged in"
msgstr "Ne garder l'écran allumé que si l'appareil est branché sur secteur"

msgid "Escape to Sleep / Suspend"
msgstr "Échap pour éteindre l'écran / mettre en veille"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "Appuyez sur Échap sur l'écran de verrouillage pour éteindre l'écran (ou mettre en veille)"

msgid "Extras"
msgstr "Extras"

msgid "Integrations"
msgstr "Intégrations"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] GDM Expansion"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "État : Activé. La disposition personnalisée est active sur GDM."

msgid "Enabled"
msgstr "Activé"

msgid "GDM Expansion - Remove"
msgstr "Extension GDM - Désinstaller"

msgid "Revert GDM login screen layout to GNOME Default. To uninstall, run copied command in a terminal."
msgstr "Rétablit la disposition de l'écran de connexion GDM par défaut de GNOME. Pour désinstaller, exécutez la commande copiée dans un terminal."

msgid "Copy uninstall command to clipboard"
msgstr "Copier la commande de désinstallation dans le presse-papiers"

msgid "Copied uninstall command to clipboard!"
msgstr "Commande de désinstallation copiée dans le presse-papiers !"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "L'extension n'est pas installée à l'échelle du système dans /usr/share."

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "Les modules d'extension GDM (src/pro) sont absents au niveau système."

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "Le mode de session GDM n'est pas activé dans les métadonnées système."

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "La configuration dconf de GDM (/etc/dconf/db/gdm.d) est manquante."

msgid "GDM integration is not configured."
msgstr "L'intégration GDM n'est pas configurée."

msgid "Status: Disabled."
msgstr "État : Désactivé."

msgid "Disabled"
msgstr "Désactivé"

msgid "Enable GDM DLC Support"
msgstr "Activer la prise en charge du DLC GDM"

msgid "Click icon to copy installer command, then run it in a terminal."
msgstr "Cliquez sur l'icône pour copier la commande d'installation, puis exécutez-la dans un terminal."

msgid "Copy install command to clipboard"
msgstr "Copier la commande d'installation dans le presse-papiers"

msgid "Copied install command to clipboard!"
msgstr "Commande d'installation copiée dans le presse-papiers !"

msgid "Upgrade to [PRO]"
msgstr "Passer à [PRO]"

msgid "Check PRO features of this extension on this extension's GitHub repo."
msgstr "Découvrez les fonctionnalités PRO de cette extension sur son dépôt GitHub."

msgid "Visit documentation on GitHub"
msgstr "Consulter la documentation sur GitHub"

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] Intégration WACK Shell"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "Installé. Active les transitions en fondu et les personnalisations de Shell inspirées de Cupertino."

msgid "Installed"
msgstr "Installé"

msgid "WACK Shell - Check for Updates"
msgstr "WACK Shell - Vérifier les mises à jour"

msgid "Copy check command to verify if a newer version of WACK Shell is available."
msgstr "Copiez la commande pour vérifier si une version plus récente de WACK Shell est disponible."

msgid "Copy update-check command to clipboard"
msgstr "Copier la commande de recherche de mise à jour"

msgid "Copied WACK Shell update-check command to clipboard!"
msgstr "Commande de vérification de mise à jour de WACK Shell copiée !"

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "Non installé. Installez WACK Shell pour débloquer les effets de transition."

msgid "Not Installed"
msgstr "Non installé"

msgid "WACK Shell - Install"
msgstr "WACK Shell - Installer"

msgid "Get advanced desktop crossfade transitions and Cupertino-inspired shell customisations. May contain bugs, report if found."
msgstr "Obtenez des transitions en fondu avancées et des personnalisations de Shell inspirées de Cupertino. Peut contenir des bogues, signalez-les si trouvés."

msgid "Copied WACK Shell install command to clipboard!"
msgstr "Commande d'installation de WACK Shell copiée dans le presse-papiers !"

msgid "Open WACK Shell repository"
msgstr "Ouvrir le dépôt WACK Shell"

msgid "Clear Visual Cache"
msgstr "Vider le cache visuel"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "Supprime les données visuelles temporaires utilisées pour les fonds d'écran et les effets de rendu. Elles seront régénérées automatiquement."

msgid "Clear"
msgstr "Vider"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "Vide le cache visuel utilisé pour les fonds d'écran et les effets de rendu"

msgid "Visual cache cleared successfully!"
msgstr "Cache visuel vidé avec succès !"

msgid "Failed to clear cache:"
msgstr "Échec du vidage du cache :"

