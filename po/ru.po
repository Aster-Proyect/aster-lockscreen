msgid "more"
msgstr "ещё"

msgid "Press Shift + N to view notifications"
msgstr "Нажмите Shift + N для просмотра уведомлений"

msgid "Sleep prevented by an active process"
msgstr "Переход в ждущий режим заблокирован активным процессом"

msgid "Home"
msgstr "Главная"

msgid "Resources"
msgstr "Ресурсы"

msgid "Extension Repo"
msgstr "Репозиторий расширения"

msgid "Open on GitHub"
msgstr "Открыть на GitHub"

msgid "Enjoying this extension?"
msgstr "Нравится расширение?"

msgid "Consider supporting its development!"
msgstr "Поддержите разработку!"

msgid "Ko-fi"
msgstr "Ko-fi"

msgid "Open Ko-fi"
msgstr "Открыть Ko-fi"

msgid "Saweria"
msgstr "Saweria"

msgid "Open Saweria"
msgstr "Открыть Saweria"

msgid "Configuration"
msgstr "Конфигурация"

msgid "General"
msgstr "Общие"

msgid "Date Style"
msgstr "Формат даты"

msgid "Choose between shortened and full date names."
msgstr "Выберите между сокращенным и полным форматом даты."

msgid "Short"
msgstr "Краткий"

msgid "Full"
msgstr "Полный"

msgid "Cursor Blinking"
msgstr "Мигание курсора"

msgid "Enable or disable text cursor blinking in the password field."
msgstr "Включает или отключает мигание курсора в поле ввода пароля."

msgid "Custom Lockscreen Wallpaper"
msgstr "Пользовательские обои экрана блокировки"

msgid "Use a custom image overlay for the lockscreen background."
msgstr "Использовать собственное изображение в качестве фона экрана блокировки."

msgid "Wallpaper Image Path"
msgstr "Путь к изображению обоев"

msgid "No image selected"
msgstr "Изображение не выбрано"

msgid "Select Image File"
msgstr "Выбрать файл изображения"

msgid "Select Lockscreen Wallpaper"
msgstr "Выбрать обои экрана блокировки"

msgid "Select"
msgstr "Выбрать"

msgid "Cancel"
msgstr "Отмена"

msgid "Image Files"
msgstr "Файлы изображений"

msgid "Lockscreen Mode"
msgstr "Режим экрана блокировки"

msgid "Mode"
msgstr "Режим"

msgid "Legacy"
msgstr "Классический"

msgid "Cupertino"
msgstr "Купертино"

msgid "A complete macOS Sonoma-inspired lockscreen layout (Click user-icon to switch users)."
msgstr "Полноценный интерфейс экрана блокировки в стиле macOS Sonoma (нажмите на значок пользователя для смены пользователя)."

msgid "macOS Sonoma-style clock over the classic, GNOME-compliant layout and flow."
msgstr "Часы в стиле macOS Sonoma поверх классического интерфейса GNOME."

msgid "Always Show User Widget"
msgstr "Всегда показывать виджет пользователя"

msgid "Hides notifications by default. Press Shift+N to show notifications."
msgstr "Скрывает уведомления по умолчанию. Нажмите Shift+N для их отображения."

msgid "Prompt Vibrancy"
msgstr "Оформление поля ввода пароля"

msgid "Adaptive color and depth enhancements for the password field."
msgstr "Адаптивное улучшение цвета и глубины для поля ввода пароля."

msgid "Tonal"
msgstr "Тональный"

msgid "Acrylic"
msgstr "Акриловый"

msgid "Lightweight, color-based mode."
msgstr "Легковесный режим на основе цвета."

msgid "Advanced, blur-based mode."
msgstr "Продвинутый режим на основе размытия."

msgid "Show message when locked"
msgstr "Показывать сообщение при блокировке"

msgid "Set..."
msgstr "Задать…"

msgid "Set a message to appear on the lockscreen"
msgstr "Задать сообщение для отображения на экране блокировки"

msgid "OK"
msgstr "ОК"

msgid "Unlock Crossfade"
msgstr "Плавный переход при разблокировке"

msgid "Crossfade the lockscreen with desktop when unlocking (automatically disabled in Power Saver mode)."
msgstr "Плавный переход от экрана блокировки к рабочему столу при разблокировке (автоматически отключается в режиме энергосбережения)."

msgid "Requires WACK Shell to be installed and enabled."
msgstr "Требуется установленное и включенное расширение WACK Shell."

msgid "Requires WACK Shell to be enabled."
msgstr "Требуется включение WACK Shell."

msgid "Crossfade Speed"
msgstr "Скорость плавного перехода"

msgid "Slower"
msgstr "Медленнее"

msgid "Faster"
msgstr "Быстрее"

msgid "Clock Animation"
msgstr "Анимация часов"

msgid "Applied to the date and time while opening the password prompt"
msgstr "Применяется к дате и времени при открытии поля ввода пароля"

msgid "Prompt Animation"
msgstr "Анимация поля ввода пароля"

msgid "Applied to the authentication prompt while it appears"
msgstr "Применяется к полю ввода пароля при его появлении"

msgid "Reset Animations"
msgstr "Сбросить анимации"

msgid "Restore defaults"
msgstr "Восстановить настройки по умолчанию"

msgid "Reset animations"
msgstr "Сбросить анимации"

msgid "Scale Down"
msgstr "Уменьшение"

msgid "Zoom Up"
msgstr "Увеличение"

msgid "Slide Up"
msgstr "Сдвиг вверх"

msgid "Fade"
msgstr "Затухание"

msgid "GNOME Default"
msgstr "По умолчанию в GNOME"

msgid "Rise"
msgstr "Всплытие"

msgid "Zoom"
msgstr "Масштабирование"

msgid "Screen Timeout"
msgstr "Выключение экрана"

msgid "Display and Power"
msgstr "Экран и питание"

msgid "Keep Screen On"
msgstr "Не выключать экран"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "Предотвращает немедленное отключение экрана при блокировке. Экран выключится после обычного времени ожидания, заданного в настройках системы."

msgid "Only on AC Power"
msgstr "Только при питании от сети"

msgid "Only keep the screen on if the system is plugged in"
msgstr "Не выключать экран только при подключении к зарядному устройству"

msgid "Escape to Sleep / Suspend"
msgstr "Escape для отключения экрана / ждущего режима"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "Нажмите Escape на экране блокировки, чтобы погасить экран (или перейти в ждущий режим)"

msgid "Extras"
msgstr "Дополнительно"

msgid "Integrations"
msgstr "Интеграции"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] GDM Expansion"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "Статус: Включено. Пользовательский интерфейс активен в GDM."

msgid "Enabled"
msgstr "Включено"

msgid "GDM Expansion - Remove"
msgstr "Модуль GDM - Удаление"

msgid "Revert GDM login screen layout to GNOME Default. To uninstall, run copied command in a terminal."
msgstr "Возвращает стандартный экран входа GDM GNOME. Для удаления выполните скопированную команду в терминале."

msgid "Copy uninstall command to clipboard"
msgstr "Скопировать команду удаления в буфер обмена"

msgid "Copied uninstall command to clipboard!"
msgstr "Команда удаления скопирована в буфер обмена!"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "Расширение не установлено системно в /usr/share."

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "Модули расширения GDM (src/pro) отсутствуют в системе."

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "Сессионный режим GDM не включен в системных метаданных."

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "Конфигурация переопределения dconf для GDM (/etc/dconf/db/gdm.d) отсутствует."

msgid "GDM integration is not configured."
msgstr "Интеграция с GDM не настроена."

msgid "Status: Disabled."
msgstr "Статус: Отключено."

msgid "Disabled"
msgstr "Отключено"

msgid "Enable GDM DLC Support"
msgstr "Включить поддержку DLC для GDM"

msgid "Click icon to copy installer command, then run it in a terminal."
msgstr "Нажмите на значок, чтобы скопировать команду установки, затем выполните её в терминале."

msgid "Copy install command to clipboard"
msgstr "Скопировать команду установки в буфер обмена"

msgid "Copied install command to clipboard!"
msgstr "Команда установки скопирована в буфер обмена!"

msgid "Upgrade to [PRO]"
msgstr "Обновиться до [PRO]"

msgid "Check PRO features of this extension on this extension's GitHub repo."
msgstr "Ознакомьтесь с возможностями PRO-версии расширения в репозитории на GitHub."

msgid "Visit documentation on GitHub"
msgstr "Открыть документацию на GitHub"

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] Интеграция с WACK Shell"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "Установлено. Включает плавные переходы и улучшения оболочки в стиле Cupertino."

msgid "Installed"
msgstr "Установлено"

msgid "WACK Shell - Check for Updates"
msgstr "WACK Shell - Проверить обновления"

msgid "Copy check command to verify if a newer version of WACK Shell is available."
msgstr "Скопируйте команду, чтобы проверить наличие новой версии WACK Shell."

msgid "Copy update-check command to clipboard"
msgstr "Скопировать команду проверки обновлений"

msgid "Copied WACK Shell update-check command to clipboard!"
msgstr "Команда проверки обновлений WACK Shell скопирована в буфер обмена!"

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "Не установлено. Установите WACK Shell для доступа к эффектам перехода."

msgid "Not Installed"
msgstr "Не установлено"

msgid "WACK Shell - Install"
msgstr "WACK Shell - Установка"

msgid "Get advanced desktop crossfade transitions and Cupertino-inspired shell customisations. May contain bugs, report if found."
msgstr "Получите улучшенные плавные переходы рабочего стола и настройки оболочки в стиле Cupertino. Может содержать ошибки; сообщайте при обнаружении."

msgid "Copied WACK Shell install command to clipboard!"
msgstr "Команда установки WACK Shell скопирована в буфер обмена!"

msgid "Open WACK Shell repository"
msgstr "Открыть репозиторий WACK Shell"

msgid "Clear Visual Cache"
msgstr "Очистить визуальный кэш"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "Удаляет временные графические данные, используемые для обоев и визуальных эффектов. Они будут созданы заново автоматически."

msgid "Clear"
msgstr "Очистить"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "Очищает визуальный кэш, используемый для обоев и визуальных эффектов"

msgid "Visual cache cleared successfully!"
msgstr "Визуальный кэш успешно очищен!"

msgid "Failed to clear cache:"
msgstr "Не удалось очистить кэш:"

