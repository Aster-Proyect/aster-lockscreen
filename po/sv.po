msgstr "Tona"

msgid "GNOME Default"
msgstr "GNOME standard"

msgid "Rise"
msgstr "Höj"

msgid "Zoom"
msgstr "Zoom"

msgid "Screen Timeout"
msgstr "Skärmavstängning"

msgid "Display and Power"
msgstr "Skärm och ström"

msgid "Keep Screen On"
msgstr "Håll skärmen igång"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "Förhindrar att skärmen släcks omedelbart vid låsning. Skärmen släcks fortfarande efter den normala tidsgräns som angetts i systeminställningarna."

msgid "Only on AC Power"
msgstr "Endast vid nätström"

msgid "Only keep the screen on if the system is plugged in"
msgstr "Håll endast skärmen igång om datorn är ansluten till nätström"

msgid "Escape to Sleep / Suspend"
msgstr "Escape för att släcka skärm / vänteläge"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "Tryck på Escape på låsskärmen för att släcka skärmen (eller gå i vänteläge)"

msgid "Extras"
msgstr "Extra"

msgid "Integrations"
msgstr "Integrationer"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] GDM Expansion"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "Status: Aktiverad. Anpassad layout är aktiv på GDM."

msgid "Enabled"
msgstr "Aktiverad"

msgid "GDM Expansion - Remove"
msgstr "GDM-tillägg - Ta bort"

msgid "Revert GDM login screen layout to GNOME Default. To uninstall, run copied command in a terminal."
msgstr "Återställ inloggningsskärmen i GDM till GNOME-standard. Kör det kopierade kommandot i en terminal för att avinstallera."

msgid "Copy uninstall command to clipboard"
msgstr "Kopiera avinstallationskommando till urklipp"

msgid "Copied uninstall command to clipboard!"
msgstr "Avinstallationskommandot har kopierats till urklipp!"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "Tillägget är inte installerat systemomfattande i /usr/share."

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "GDM-tilläggsmoduler (src/pro) saknas i systemet."

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "GDM-sessionsläget är inte aktiverat i systemomfattande metadata."

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "GDM dconf-åsidosättningskonfiguration (/etc/dconf/db/gdm.d) saknas."

msgid "GDM integration is not configured."
msgstr "GDM-integrering är inte konfigurerad."

msgid "Status: Disabled."
msgstr "Status: Inaktiverad."

msgid "Disabled"
msgstr "Inaktiverad"

msgid "Enable GDM DLC Support"
msgstr "Aktivera GDM DLC-stöd"

msgid "Click icon to copy installer command, then run it in a terminal."
msgstr "Klicka på ikonen för att kopiera installationskommandot och kör det sedan i en terminal."

msgid "Copy install command to clipboard"
msgstr "Kopiera installationskommando till urklipp"

msgid "Copied install command to clipboard!"
msgstr "Installationskommandot har kopierats till urklipp!"

msgid "Upgrade to [PRO]"
msgstr "Uppgradera till [PRO]"

msgid "Check PRO features of this extension on this extension's GitHub repo."
msgstr "Utforska PRO-funktionerna för detta tillägg i dess GitHub-arkiv."

msgid "Visit documentation on GitHub"
msgstr "Visa dokumentation på GitHub"

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] WACK Shell-integrering"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "Installerat. Aktiverar mjuka övergångar och Cupertino-inspirerade skalanpassningar."

msgid "Installed"
msgstr "Installerat"

msgid "WACK Shell - Check for Updates"
msgstr "WACK Shell - Sök efter uppdateringar"

msgid "Copy check command to verify if a newer version of WACK Shell is available."
msgstr "Kopiera kommandot för att kontrollera om en nyare version av WACK Shell finns tillgänglig."

msgid "Copy update-check command to clipboard"
msgstr "Kopiera uppdateringskontroll-kommando"

msgid "Copied WACK Shell update-check command to clipboard!"
msgstr "Kommandot för att söka efter WACK Shell-uppdateringar har kopierats!"

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "Inte installerat. Installera WACK Shell för att låsa upp övergångseffekter."

msgid "Not Installed"
msgstr "Inte installerat"

msgid "WACK Shell - Install"
msgstr "WACK Shell - Installera"

msgid "Get advanced desktop crossfade transitions and Cupertino-inspired shell customisations. May contain bugs, report if found."
msgstr "Få avancerade mjuka skrivbordsövergångar och Cupertino-inspirerade skaljusteringar. Kan innehålla fel; rapportera om du hittar några."

msgid "Copied WACK Shell install command to clipboard!"
msgstr "WACK Shell-installationskommandot har kopierats till urklipp!"

msgid "Open WACK Shell repository"
msgstr "Öppna WACK Shell-arkiv"

msgid "Clear Visual Cache"
msgstr "Rensa visuell cache"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "Rensar tillfälliga visuella data som används för bakgrundsbilder och visuella effekter. De återskapas automatiskt."

msgid "Clear"
msgstr "Rensa"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "Rensar den visuella cachen som används för bakgrundsbilder och visuella effekter"

msgid "Visual cache cleared successfully!"
msgstr "Visuell cache har rensats!"

msgid "Failed to clear cache:"
msgstr "Kunde inte rensa cache:"

